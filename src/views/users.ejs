<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap">
  <div class="page-head">
    <div>
      <h1>Users</h1>
      <p class="sub">Administrators see and manage every site. Standard users only see the sites they own.</p>
    </div>
    <div class="page-actions">
      <button class="btn btn-primary" id="add-user-btn"><%- icon('plus') %><span>Add User</span></button>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <% if (generatedPassword) { %>
    <div class="alert alert-ok">
      <strong><%= generatedPassword.username %> created.</strong> This password is shown once and the user must change it at first login.
      <div class="copy-field mt">
        <input type="text" value="<%= generatedPassword.password %>" readonly onclick="this.select()">
        <button class="btn btn-sm" data-copy="<%= generatedPassword.password %>" data-copy-label="Password">Copy</button>
      </div>
    </div>
  <% } %>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="table-wrap">
      <table class="users-table">
            <thead>
              <tr>
                <th>User</th>
                <th style="width:150px">Role &amp; status</th>
                <th style="width:110px">Sites</th>
                <th style="width:170px" class="right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function (u) { %>
                <tr>
                  <td>
                    <div class="user-cell">
                      <span class="avatar avatar-lg"><%= u.username.slice(0, 1).toUpperCase() %></span>
                      <div>
                        <div class="user-name"><%= u.username %></div>
                        <div class="muted small">
                          <%= u.email ? u.email : 'no email' %>
                          <span class="dot-sep">&middot;</span>
                          <% if (u.last_login) { %>
                            last seen <span class="rel" data-time="<%= u.last_login %>"><%= u.last_login %></span>
                          <% } else { %>never signed in<% } %>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="pill <%= u.role === 'admin' ? 'pill-admin' : '' %>"><%= u.role === 'admin' ? 'admin' : 'user' %></span>
                    <span class="pill <%= u.active ? 'pill-running' : 'pill-error' %>"><%= u.active ? 'active' : 'disabled' %></span>
                    <span class="pill <%= u.totp_enabled ? 'pill-running' : 'pill-error' %>"
                          title="<%= u.totp_enabled ? 'Two-factor authentication is on' : 'No second factor on this account' %>">
                      2FA <%= u.totp_enabled ? 'on' : 'off' %>
                    </span>
                  </td>
                  <td class="muted small nowrap">
                    <%= u.site_count %><%= u.site_quota ? ' of ' + u.site_quota : '' %>
                    <%= u.site_quota ? '' : ' (no limit)' %>
                  </td>
                  <td class="right">
                    <div class="file-actions">
                      <button class="btn btn-sm" data-edit-user="<%= u.id %>" title="Edit this user">
                        <%- icon('edit') %><span>Edit</span>
                      </button>
                      <button class="btn btn-sm" data-reset-user="<%= u.id %>" title="Generate a new password">
                        <%- icon('key') %><span>Password</span>
                      </button>
                      <% if (u.totp_enabled) { %>
                        <button class="btn btn-sm" data-reset2fa-user="<%= u.id %>"
                                title="Clear their second factor - for a lost phone">
                          <%- icon('shield') %>
                        </button>
                      <% } %>
                      <% if (u.id !== user.id) { %>
                        <button class="btn btn-sm btn-danger" data-delete-user="<%= u.id %>" title="Delete this user">
                          <%- icon('trash') %>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="new-user-modal">
  <div class="modal">
    <div class="modal-head">
      <h3>Add a User</h3>
      <button class="btn btn-sm btn-ghost" aria-label="Close" data-close-modal="new-user-modal"><%- icon('close') %></button>
    </div>
    <form method="post" action="/users">
      <div class="modal-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="u-username">Username</label>
          <input id="u-username" name="username" type="text" required autocomplete="off">
        </div>
        <div class="field">
          <label for="u-email">Email <span class="muted">(optional)</span></label>
          <input id="u-email" name="email" type="email" autocomplete="off">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="u-role">Role</label>
            <select id="u-role" name="role">
              <option value="user">Standard User</option>
              <option value="admin">Administrator</option>
            </select>
          </div>
          <div class="field">
            <label for="u-quota">Site Limit</label>
            <input id="u-quota" name="site_quota" type="number" min="0" value="0">
            <div class="hint">0 means no limit.</div>
          </div>
        </div>
        <div class="field">
          <label for="u-password">Password</label>
          <input id="u-password" name="password" type="text" autocomplete="off"
                 placeholder="leave blank to generate one">
          <div class="hint">
            At least 10 characters if you set it yourself. Either way they must
            change it at first login.
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-close-modal="new-user-modal">Cancel</button>
        <button class="btn btn-primary" type="submit"><%- icon('plus') %><span>Create User</span></button>
      </div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="edit-modal">
  <div class="modal">
    <div class="modal-head"><h3 id="edit-title">Edit User</h3><button class="btn btn-sm btn-ghost" aria-label="Close" data-close-modal="edit-modal"><%- icon('close') %></button></div>
    <div class="modal-body">
      <div class="field"><label for="e-email">Email</label><input id="e-email" type="email"></div>
      <div class="field-row">
        <div class="field">
          <label for="e-role">Role</label>
          <select id="e-role"><option value="user">Standard User</option><option value="admin">Administrator</option></select>
        </div>
        <div class="field">
          <label for="e-quota">Site Limit</label>
          <input id="e-quota" type="number" min="0">
        </div>
      </div>
      <div class="check">
        <input type="checkbox" id="e-active">
        <label for="e-active">Account Is Active</label>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" data-close-modal="edit-modal">Cancel</button>
      <button class="btn btn-primary" id="edit-save">Save</button>
    </div>
  </div>
</div>

<script>
  document.getElementById('add-user-btn').addEventListener('click', function () {
    HP.openModal('new-user-modal');
    var first = document.getElementById('u-username');
    if (first) setTimeout(function () { first.focus(); }, 60);
  });

  var editingId = null;
  // The whole row set, handed over as data rather than built into onclick
  // attributes. Markup that carries JSON has to be escaped exactly right to
  // stay safe; a lookup table cannot be got wrong in the same way.
  var USERS = <%- jsonScript(users.map(function (u) {
    return {
      id: u.id,
      username: u.username,
      email: u.email || '',
      role: u.role,
      active: !!u.active,
      site_quota: u.site_quota,
      site_count: u.site_count,
      totp_enabled: !!u.totp_enabled,
    };
  })) %>;

  function userById(id) {
    return USERS.filter(function (u) { return String(u.id) === String(id); })[0];
  }

  document.querySelectorAll('[data-edit-user]').forEach(function (b) {
    b.addEventListener('click', function () { editUser(userById(b.getAttribute('data-edit-user'))); });
  });
  document.querySelectorAll('[data-reset-user]').forEach(function (b) {
    b.addEventListener('click', function () {
      var u = userById(b.getAttribute('data-reset-user'));
      resetPw(u.id, u.username);
    });
  });
  document.querySelectorAll('[data-reset2fa-user]').forEach(function (b) {
    b.addEventListener('click', async function () {
      var u = userById(b.getAttribute('data-reset2fa-user'));
      var ok = await HP.confirm({
        title: 'Clear two-factor for ' + u.username + '?',
        message: 'Their authenticator app and recovery codes stop working, and they sign in ' +
          'with their password alone until they set it up again. Their current sessions end. ' +
          'Only do this when you are sure who you are talking to - it is the one step that ' +
          'turns two-factor back into one.',
        confirmText: 'Clear two-factor',
        tone: 'warn'
      });
      if (!ok) return;
      try {
        await HP.api('/users/' + u.id + '/reset-2fa', { body: {} });
        HP.toast('Two-factor cleared for ' + u.username, 'ok');
        setTimeout(function () { location.reload(); }, 600);
      } catch (err) { HP.toast(err.message, 'error'); }
    });
  });

  document.querySelectorAll('[data-delete-user]').forEach(function (b) {
    b.addEventListener('click', function () {
      var u = userById(b.getAttribute('data-delete-user'));
      delUser(u.id, u.username, u.site_count);
    });
  });

  // Absolute timestamps are hard to read at a glance; keep the exact value on
  // hover for when it matters.
  document.querySelectorAll('.rel[data-time]').forEach(function (el) {
    var iso = el.getAttribute('data-time').replace(' ', 'T') + 'Z';
    var when = new Date(iso);
    if (isNaN(when.getTime())) return;
    el.title = when.toLocaleString();
    el.textContent = HP.relTime(when.getTime());
  });

  function editUser(u) {
    editingId = u.id;
    document.getElementById('edit-title').textContent = 'Edit ' + u.username;
    document.getElementById('e-email').value = u.email;
    document.getElementById('e-role').value = u.role;
    document.getElementById('e-quota').value = u.site_quota;
    document.getElementById('e-active').checked = u.active;
    HP.openModal('edit-modal');
  }

  document.getElementById('edit-save').addEventListener('click', async function () {
    try {
      await HP.api('/users/' + editingId + '/update', {
        body: {
          email: document.getElementById('e-email').value,
          role: document.getElementById('e-role').value,
          site_quota: document.getElementById('e-quota').value,
          active: document.getElementById('e-active').checked
        }
      });
      HP.toast('Saved', 'ok');
      setTimeout(function () { location.reload(); }, 500);
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  async function resetPw(id, username) {
    var ok = await HP.confirm({
      title: 'Reset this password?',
      message: 'A new password is generated for ' + username + '. Their current one stops ' +
        'working immediately and any signed-in session ends.',
      confirmText: 'Reset password',
      tone: 'warn'
    });
    if (!ok) return;
    try {
      var res = await HP.api('/users/' + id + '/password', { body: {} });
      await HP.dialog({
        title: 'New password for ' + username,
        message: 'This is shown once. Copy it now - they must change it at first login.',
        tone: 'ok',
        input: true,
        readonly: true,
        value: res.password,
        copyValue: res.password,
        copyLabel: 'Password',
        confirmText: 'Done',
        cancelText: null
      });
    } catch (err) { HP.toast(err.message, 'error'); }
  }

  async function delUser(id, username, siteCount) {
    var reassign = null;
    if (siteCount > 0) {
      var others = USERS.filter(function (u) { return u.id !== id; });
      if (!others.length) {
        await HP.alert({
          title: 'Cannot delete this user',
          message: username + ' owns ' + siteCount + ' site(s) and there is nobody to ' +
            'hand them to. Create another user first.',
          tone: 'warn'
        });
        return;
      }
      var answer = await HP.prompt({
        title: 'Who should take over the sites?',
        message: username + ' owns ' + siteCount + ' site(s). Enter the ID of the user who ' +
          'should own them instead.',
        list: others.map(function (u) { return u.id + ' = ' + u.username; }),
        inputLabel: 'User ID',
        confirmText: 'Reassign and delete',
        tone: 'warn'
      });
      if (!answer) return;
      reassign = String(answer).trim();
    } else {
      var ok = await HP.confirm({
        title: 'Delete ' + username + '?',
        message: 'Their account is removed. This cannot be undone.',
        confirmText: 'Delete user',
        danger: true
      });
      if (!ok) return;
    }
    try {
      await HP.api('/users/' + id + '/delete', { body: { reassign_to: reassign } });
      HP.toast('Deleted', 'ok');
      setTimeout(function () { location.reload(); }, 500);
    } catch (err) { HP.toast(err.message, 'error'); }
  }
</script>
<%- include('partials/foot') %>
