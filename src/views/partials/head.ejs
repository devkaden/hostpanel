<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> &middot; <%= panelTitle %></title>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
  <link rel="icon" href="/static/logo.svg?v=<%= assetVersion %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/static/logo.svg?v=<%= assetVersion %>">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (typeof brandAccent !== 'undefined' && brandAccent) { %>
    <style>:root { --accent: <%= brandAccent %>; }</style>
  <% } %>
  <script>
    /* Resolve theme and interface mode before first paint, so the page never
       flashes the wrong colours. Both fall back to the server-side default. */
    (function () {
      var serverTheme = <%- jsonScript(typeof themeSetting !== 'undefined' ? themeSetting : 'system') %>;
      var serverMode = <%- jsonScript(typeof uiModeSetting !== 'undefined' ? uiModeSetting : 'simple') %>;
      // The server value wins: it is the preference saved against this
      // account. localStorage is only kept in step so a page painted before
      // the server responds still looks right.
      var theme = serverTheme, mode = serverMode;
      try {
        localStorage.setItem('hp-theme', theme);
        localStorage.setItem('hp-mode', mode);
      } catch (e) { /* private mode */ }

      if (theme === 'system') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light' : 'dark';
      }
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-mode', mode);
    })();
  </script>
</head>
<body class="mode-simple">
<script>
  // body.className is set here rather than inline so the class always matches
  // the mode resolved above, even when localStorage disagrees with the server.
  document.body.className = 'mode-' + (document.documentElement.getAttribute('data-mode') || 'simple');
</script>
