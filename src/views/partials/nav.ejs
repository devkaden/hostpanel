<% const u = (typeof user !== 'undefined') ? user : null; %>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark">
      <% if (typeof brandLogo !== 'undefined' && brandLogo) { %>
        <img src="<%= brandLogo %>" alt="">
      <% } else { %>HP<% } %>
    </span>
    <span class="brand-name"><%= panelTitle %></span>
  </a>

  <nav class="topnav" aria-label="Main">
    <a href="/" class="<%= currentPath === '/' || currentPath.startsWith('/sites') ? 'active' : '' %>">
      <%- icon('sites') %><span>Sites</span>
    </a>
    <% if (u && u.role === 'admin') { %>
      <a href="/users" class="<%= currentPath.startsWith('/users') ? 'active' : '' %>">
        <%- icon('users') %><span>Users</span>
      </a>
      <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">
        <%- icon('settings') %><span>Settings</span>
      </a>
      <% if (typeof hostShell !== 'undefined' && hostShell) { %>
        <a href="/host/terminal" class="adv <%= currentPath === '/host/terminal' ? 'active' : '' %>">
          <%- icon('terminal') %><span>Host shell</span>
        </a>
      <% } %>
    <% } %>
    <a href="/audit" class="adv <%= currentPath === '/audit' ? 'active' : '' %>">
      <%- icon('activity') %><span>Activity</span>
    </a>
  </nav>

  <div class="topbar-right">
    <% if (u) { %>
      <a class="btn btn-primary btn-sm" href="/sites/new" title="Create a new site">
        <%- icon('plus') %><span class="btn-label">New Site</span>
      </a>

      <div class="seg seg-mode adv" title="Simple hides Docker internals. Advanced shows everything.">
        <button type="button" data-mode-set="simple">Simple</button>
        <button type="button" data-mode-set="advanced">Advanced</button>
      </div>

      <button type="button" class="icon-btn" id="theme-toggle"
              title="Switch between light and dark" aria-label="Switch theme">
        <span class="theme-sun"><%- icon('sun') %></span>
        <span class="theme-moon"><%- icon('moon') %></span>
      </button>

      <div class="menu" id="account-menu">
        <button type="button" class="menu-trigger" aria-haspopup="true" aria-expanded="false">
          <span class="avatar"><%= u.username.slice(0, 1).toUpperCase() %></span>
          <span class="menu-name"><%= u.username %></span>
          <%- icon('chevronDown', 'ico-sm') %>
        </button>
        <div class="menu-panel" role="menu">
          <div class="menu-head">
            <div class="menu-user"><%= u.username %></div>
            <div class="menu-role"><%= u.role === 'admin' ? 'Administrator' : 'Standard user' %></div>
          </div>
          <div class="menu-sep"></div>
          <button type="button" class="menu-item" data-mode-toggle>
            <%- icon('settings') %>
            <span>Interface: <strong data-mode-label>Simple</strong></span>
          </button>
          <a class="menu-item" href="/account" role="menuitem">
            <%- icon('userCircle') %><span>Your Account</span>
          </a>
          <a class="menu-item" href="/account/password" role="menuitem">
            <%- icon('key') %><span>Change Password</span>
          </a>
          <a class="menu-item" href="/account/2fa" role="menuitem">
            <%- icon('shield') %>
            <span>Two-Factor
              <% if (typeof twoFactorOn !== 'undefined' && twoFactorOn) { %>
                <span class="pill pill-running">On</span>
              <% } else { %>
                <span class="pill pill-error">Off</span>
              <% } %>
            </span>
          </a>
          <div class="menu-sep"></div>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="menu-item menu-danger" type="submit">
              <%- icon('signOut') %><span>Sign Out</span>
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</header>
