<% const u = (typeof user !== 'undefined') ? user : null; %>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark">HP</span>
    <span><%= panelTitle %></span>
  </a>
  <nav class="topnav">
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Sites</a>
    <a href="/sites/new" class="<%= currentPath === '/sites/new' ? 'active' : '' %>">New site</a>
    <% if (u && u.role === 'admin') { %>
      <a href="/users" class="<%= currentPath.startsWith('/users') ? 'active' : '' %>">Users</a>
      <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">Settings</a>
      <% if (typeof hostShell !== 'undefined' && hostShell) { %>
        <a href="/host/terminal" class="<%= currentPath === '/host/terminal' ? 'active' : '' %>">Host shell</a>
      <% } %>
    <% } %>
    <a href="/audit" class="<%= currentPath === '/audit' ? 'active' : '' %>">Activity</a>
  </nav>
  <div class="topbar-right">
    <% if (u) { %>
      <span class="who"><%= u.username %><% if (u.role === 'admin') { %><span class="pill pill-admin">admin</span><% } %></span>
      <a class="btn btn-ghost btn-sm" href="/account/password">Password</a>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
      </form>
    <% } %>
  </div>
</header>
