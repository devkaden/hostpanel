<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap wrap-narrow">
  <div class="card">
    <h1 style="font-size:1.2rem;margin:0 0 .5rem"><%= title %></h1>
    <p class="muted" style="margin:0 0 1rem"><%= message %></p>
    <p class="muted small" style="margin:0 0 1.2rem">
      If this keeps happening, the panel's log usually explains why:
      <code class="inline">journalctl -u hostpanel -n 50</code>
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Back to sites</a>
      <button class="btn" type="button" onclick="history.back()">Go back</button>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
