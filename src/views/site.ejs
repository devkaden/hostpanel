<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap">

  <div class="page-head">
    <div>
      <h1>
        <span class="type-badge"><%= siteTypes[site.type] ? siteTypes[site.type].icon : '?' %></span>
        <%= site.name %>
        <span class="pill pill-<%= live.state %>" id="state-pill"><span class="dot"></span><%= live.state %></span>
      </h1>
      <p class="sub">
        <%= siteTypes[site.type] ? siteTypes[site.type].label : site.type %>
        &middot; host port <%= site.port %>
        <% if (domains.length) { %>
          &middot; <% domains.forEach(function (d, i) { %><a href="http<%= site.ssl ? 's' : '' %>://<%= d %>" target="_blank" rel="noopener"><%= d %></a><%= i < domains.length - 1 ? ', ' : '' %><% }) %>
        <% } %>
      </p>
    </div>
    <div class="page-actions">
      <% if (previewUrl) { %>
        <a class="btn" href="<%= previewUrl %>" target="_blank" rel="noopener">
          <%- icon('external') %><span>Open site</span>
        </a>
      <% } %>
    </div>
  </div>

  <%- include('partials/site-tabs') %>

  <% if (live.needsDependencies && !provisioning && !busy) { %>
    <div class="alert alert-error" id="deps-alert">
      <strong>Dependencies are not installed.</strong>
      This site has a <code>package.json</code> but no <code>node_modules</code>, so it exits
      on start with <code>Cannot find module</code>. Press
      <button class="btn btn-sm btn-primary" id="deps-install">Install dependencies</button>
      and the site will start on its own once that finishes.
    </div>
  <% } %>

  <% if (live.state === 'running' && live.reachable === false && !provisioning && !busy) { %>
    <div class="alert alert-warn" id="unreachable-alert">
      <strong>The container is running, but nothing is answering on port <%= site.port %>.</strong>
      That is why the preview is blank. Two things cause it nearly every time:
      <ul style="margin:.4rem 0 0 1.1rem">
        <li>The app listens on <code>127.0.0.1</code> or <code>localhost</code>. Inside a container
          that means "reachable only from within this container". It has to bind
          <code>0.0.0.0</code> to be reachable from outside.</li>
        <li>The app listens on a different port than <strong>Internal port</strong> is set to
          (currently <code><%= site.app_port %></code>). The panel sets <code>PORT</code> in the
          environment &mdash; use it, or change the setting to match what the app hard-codes.</li>
      </ul>
      The <strong>Logs</strong> tab usually prints the address the app chose.
    </div>
  <% } %>

  <% if (live.state === 'missing' && !provisioning && !busy) { %>
    <div class="alert alert-error" id="missing-alert">
      <strong>This site has no container yet.</strong> That usually means the build failed or it was removed
      outside the panel. Press <strong>Apply changes</strong> above to build it again &mdash; your files are untouched.
    </div>
  <% } %>

  <div class="card" id="progress-card" style="<%= provisioning ? '' : 'display:none' %>">
    <div class="card-head">
      <h2>Build output</h2>
      <button class="btn btn-sm btn-ghost" aria-label="Close" onclick="document.getElementById('progress-card').style.display='none'">Hide</button>
    </div>
    <div class="console" id="progress-console">Waiting for output...</div>
  </div>

  <% if (previewUrl) { %>
    <button class="btn btn-sm preview-show" id="preview-show" style="display:none">
      <%- icon('eye') %><span>Show preview</span>
    </button>
    <div class="card" id="preview-card">
      <div class="card-head">
        <h2>Preview</h2>
        <div class="preview-bar" style="margin:0">
          <div class="seg" role="group" aria-label="Preview width">
            <button type="button" data-size="desktop" aria-pressed="true">Desktop</button>
            <button type="button" data-size="tablet" aria-pressed="false">Tablet</button>
            <button type="button" data-size="phone" aria-pressed="false">Phone</button>
          </div>
          <button class="btn btn-sm" id="preview-reload" title="Reload the preview">
            <%- icon('refresh') %><span>Refresh</span>
          </button>
          <a class="btn btn-sm" href="<%= previewUrl %>" target="_blank" rel="noopener">
            <%- icon('external') %><span>New tab</span>
          </a>
          <button class="btn btn-sm btn-ghost" aria-label="Close" id="preview-hide" title="Hide the preview">
            <%- icon('eyeOff') %><span>Hide</span>
          </button>
        </div>
      </div>

      <div class="preview-bar">
        <span class="preview-url"><%= previewUrl %></span>
        <% if (domains.length) { %>
          <span class="muted small">
            &mdash; this is the site itself, reached directly. Visitors go through
            <%= domains[0] %>.
          </span>
        <% } %>
      </div>

      <div class="alert alert-warn" id="csp-note" style="display:none"></div>
      <div class="alert alert-warn" id="preview-note-live" style="display:none"></div>

      <div class="preview-frame size-desktop" id="preview-frame">
        <iframe
          id="preview-iframe"
          src="<%= previewUrl %>"
          title="Preview of <%= site.name %>"
          loading="lazy"
          referrerpolicy="no-referrer"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
        <% if (live.state !== 'running' && live.state !== 'healthy') { %>
          <div class="preview-note">
            The site is <%= live.state %>, so there is nothing to show yet.<br>
            Start it above, then refresh this preview.
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="grid grid-2">

    <!-- ------------------------------------------------------------ left -->
    <div>
      <div class="card">
        <h2>How this site is running</h2>
        <dl class="dl">
          <dt>Status</dt><dd><%= live.state %></dd>
          <dt>Reachable at</dt>
          <dd>
            <% if (hostIp) { %>
              <a href="http://<%= hostIp %>:<%= site.port %>" target="_blank" rel="noopener"><%= hostIp %>:<%= site.port %></a>
            <% } else { %>
              port <%= site.port %>
            <% } %>
            <span class="help" data-help="The port this site is published on. Your reverse proxy forwards your domain here."></span>
          </dd>
          <dt>Type</dt><dd><%= siteTypes[site.type] ? siteTypes[site.type].label : site.type %><%= site.runtime_version ? ' ' + site.runtime_version : '' %></dd>
          <dt>Memory in use</dt><dd id="stat-mem"><%= stats ? Math.round(stats.memoryBytes / 1048576) + ' MB' : '-' %></dd>
          <dt>CPU in use</dt><dd id="stat-cpu"><%= stats ? stats.cpuPercent + ' %' : '-' %></dd>
          <dt>Files</dt><dd><%= disk.human %> across <%= disk.files %> file<%= disk.files === 1 ? '' : 's' %></dd>
          <dt>Created</dt><dd><%= site.created_at %> UTC</dd>

          <dt class="adv">Container name</dt><dd class="adv"><code class="inline"><%= containerName %></code></dd>
          <dt class="adv">Image</dt><dd class="adv"><code class="inline"><%= image %></code></dd>
          <dt class="adv">Internal port</dt><dd class="adv"><%= site.app_port %></dd>
          <% if (dbContainerName) { %>
            <dt class="adv">Database container</dt><dd class="adv"><code class="inline"><%= dbContainerName %></code> &middot; <%= live.dbState %></dd>
          <% } %>
          <dt class="adv">Folder on disk</dt><dd class="adv"><code class="inline"><%= dirs.root %></code></dd>
        </dl>
      </div>

      <% if (site.type === 'wordpress') { %>
        <div class="card">
          <h2>Database</h2>
          <dl class="dl">
            <dt>Host</dt><dd><code class="inline"><%= dbContainerName %>:3306</code></dd>
            <dt>Database</dt><dd><code class="inline"><%= site.db_name %></code></dd>
            <dt>User</dt><dd><code class="inline"><%= site.db_user %></code></dd>
            <dt>Password</dt>
            <dd>
              <span class="copy-field">
                <input type="password" value="<%= site.db_password %>" id="dbpw" readonly style="max-width:230px">
                <button class="btn btn-sm" type="button" onclick="document.getElementById('dbpw').type = document.getElementById('dbpw').type === 'password' ? 'text' : 'password'">Show</button>
                <button class="btn btn-sm" type="button" data-copy="<%= site.db_password %>" data-copy-label="Password">Copy</button>
              </span>
            </dd>
          </dl>
          <p class="hint muted small">Reach the database from a shell with
            <code class="inline">mariadb -h <%= dbContainerName %> -u <%= site.db_user %> -p <%= site.db_name %></code>.</p>
        </div>
      <% } %>

      <div class="card">
        <div class="card-head">
          <h2>Reverse proxy (NPMplus)</h2>
          <% if (site.ssl) { %><span class="pill pill-ssl">SSL active</span><% } %>
        </div>

        <% if (!npmplusConfigured) { %>
          <p class="muted small">NPMplus is not configured yet.
            <% if (user.role === 'admin') { %><a href="/settings">Set it up in Settings</a> to manage proxy hosts from here.<% } %></p>
        <% } else if (!domains.length) { %>
          <p class="muted small">Add a domain below, then create the proxy host.</p>
        <% } else { %>
          <dl class="dl">
            <dt>Proxy host</dt>
            <dd><%= site.npm_proxy_id ? '#' + site.npm_proxy_id : 'not created' %></dd>
            <dt>Certificate</dt>
            <dd><%= site.npm_cert_id ? '#' + site.npm_cert_id : (site.ssl ? 'attached' : 'none') %></dd>
            <% if (proxyHost) { %>
              <dt>Forwards to</dt>
              <dd><code class="inline"><%= proxyHost.forward_scheme %>://<%= proxyHost.forward_host %>:<%= proxyHost.forward_port %></code></dd>
              <dt>Domains</dt>
              <dd><%= (proxyHost.domain_names || []).join(', ') %></dd>
            <% } %>
          </dl>
          <% if (proxyError) { %><div class="alert alert-warn mt small"><%= proxyError %></div><% } %>
          <div class="btn-row mt">
            <button class="btn btn-primary btn-sm" id="proxy-sync">
              <%= site.npm_proxy_id ? 'Re-sync proxy + SSL' : 'Create proxy + SSL' %>
            </button>
            <button class="btn btn-sm" id="proxy-sync-nossl">Sync without SSL</button>
            <% if (site.npm_proxy_id) { %>
              <button class="btn btn-danger btn-sm" id="proxy-delete">Remove proxy host</button>
            <% } %>
          </div>
          <p class="hint muted small mt">
            Point the DNS for <%= domains.join(', ') %> at NPMplus before requesting a certificate,
            or the HTTP-01 challenge will fail.
          </p>
        <% } %>
      </div>
    </div>

    <!-- ----------------------------------------------------------- right -->
    <div>
      <div class="card">
        <h2>Settings</h2>
        <form id="settings-form">
          <div class="field">
            <label for="s-domain">
              Web address
              <span class="help" data-help="The domain visitors type. Its DNS must point at your reverse proxy."></span>
            </label>
            <input id="s-domain" name="domain" type="text" value="<%= site.domain || '' %>" placeholder="app.example.com">
          </div>
          <div class="field adv">
            <label for="s-extra">Other addresses for the same site</label>
            <input id="s-extra" name="extra_domains" type="text" value="<%= site.extra_domains || '' %>" placeholder="www.example.com, example.com">
          </div>

          <% if (site.type === 'php' || site.type === 'wordpress') { %>
            <div class="field">
              <label for="s-runtime">PHP version</label>
              <select id="s-runtime" name="runtime_version">
                <% (site.type === 'wordpress' ? config.wordpressPhpVersions : config.phpVersions).forEach(function (v) { %>
                  <option value="<%= v %>" <%= site.runtime_version === v ? 'selected' : '' %>><%= v %></option>
                <% }) %>
              </select>
              <div class="hint">Changing this needs a rebuild.</div>
            </div>
          <% } %>

          <% if (site.type === 'node') { %>
            <div class="field">
              <label for="s-runtime">Node.js version</label>
              <select id="s-runtime" name="runtime_version">
                <% config.nodeVersions.forEach(function (v) { %>
                  <option value="<%= v %>" <%= site.runtime_version === v ? 'selected' : '' %>><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label for="s-packages">
                Extra programs
                <span class="help" data-help="Command-line programs your app runs, installed into this site's container. Space separated, e.g. ffmpeg yt-dlp imagemagick git. These are system programs, not npm packages. Press Apply changes afterwards."></span>
              </label>
              <input id="s-packages" name="system_packages" type="text"
                     value="<%= site.system_packages %>"
                     placeholder="ffmpeg yt-dlp">
            </div>
            <div class="field-row adv">
              <div class="field">
                <label for="s-install">Install command</label>
                <input id="s-install" name="install_command" type="text" value="<%= site.install_command %>">
              </div>
              <div class="field">
                <label for="s-start">Start command</label>
                <input id="s-start" name="start_command" type="text" value="<%= site.start_command %>">
              </div>
            </div>
          <% } %>

          <div class="field adv">
            <label for="s-port">
              Port on this server
              <span class="help" data-help="Change this only if the port clashes with something else. Rebuild afterwards, and update your reverse proxy to match."></span>
            </label>
            <input id="s-port" name="port" type="number" min="1024" max="65535" value="<%= site.port %>">
            <div id="port-feedback"></div>
          </div>

          <div class="field adv">
            <label for="s-appport-any">
              Internal port
              <span class="help" data-help="The port the server inside the container listens on. Leave it unless your app needs something specific."></span>
            </label>
            <input id="s-appport-any" name="app_port" type="number" min="1" max="65535" value="<%= site.app_port %>">
          </div>

          <div class="field-row adv">
            <div class="field">
              <label for="s-mem">Memory limit (MB)</label>
              <input id="s-mem" name="memory_mb" type="number" min="0" step="64" value="<%= site.memory_mb %>">
            </div>
            <div class="field">
              <label for="s-cpu">CPU limit (cores)</label>
              <input id="s-cpu" name="cpu_limit" type="number" min="0" step="0.25" value="<%= site.cpu_limit %>">
            </div>
          </div>

          <div class="field adv">
            <label for="s-env">
              Environment variables
              <span class="help" data-help="Settings passed to your app, written as JSON."></span>
            </label>
            <textarea id="s-env" name="env_json" spellcheck="false"><%= site.env_json %></textarea>
          </div>

          <% if (owners && owners.length) { %>
            <div class="field adv">
              <label for="s-owner">Belongs to</label>
              <select id="s-owner" name="owner_id">
                <% owners.forEach(function (o) { %>
                  <option value="<%= o.id %>" <%= site.owner_id === o.id ? 'selected' : '' %>><%= o.username %></option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <div class="field">
            <label for="s-notes">Notes</label>
            <textarea id="s-notes" name="notes" style="min-height:64px" spellcheck="true"><%= site.notes %></textarea>
          </div>

          <div class="field adv">
            <label for="s-network">
              Docker network
              <span class="help" data-help="Blank means this site gets its own private network."></span>
            </label>
            <input id="s-network" name="docker_network" type="text" value="<%= site.docker_network || '' %>" placeholder="its own private network">
          </div>

          <div class="field adv">
            <label for="s-image">
              Custom Docker image
              <span class="help" data-help="Replaces the default image for this site type. Rebuild to apply."></span>
            </label>
            <input id="s-image" name="custom_image" type="text" value="<%= site.custom_image || '' %>" placeholder="default for this type">
          </div>

          <div class="field adv">
            <label for="s-volumes">
              Extra folders to mount
              <span class="help" data-help="One per line, as folder:/path/in/container. Must stay inside this site's own directory."></span>
            </label>
            <textarea id="s-volumes" name="extra_volumes" spellcheck="false" style="min-height:64px"><%= site.extra_volumes || '' %></textarea>
          </div>

          <div class="field adv">
            <label for="s-labels">
              Container labels
              <span class="help" data-help="Docker labels as JSON, for tools like Watchtower or Traefik."></span>
            </label>
            <textarea id="s-labels" name="extra_labels" spellcheck="false" style="min-height:52px"><%= site.extra_labels || '{}' %></textarea>
          </div>

          <div class="btn-row">
            <button class="btn btn-primary" type="submit">Save settings</button>
            <button class="btn" type="button" data-action="rebuild">Apply changes and restart</button>
            <button class="btn adv" type="button" onclick="HP.openModal('template-modal')">Save as preset</button>
          </div>
        </form>
      </div>

      <div class="card">
        <h2>Danger zone</h2>
        <p class="muted small">Deleting removes the container, the network, the NPMplus proxy host and (optionally) every file in the site directory. This cannot be undone.</p>
        <button class="btn btn-danger" onclick="HP.openModal('delete-modal')">Delete this site</button>
      </div>
    </div>
  </div>
</div>

<!-- ------------------------------------------------------------- modal -->
<div class="modal-backdrop" id="delete-modal">
  <div class="modal">
    <div class="modal-head">
      <h3>Delete <%= site.name %></h3>
      <button class="btn btn-sm btn-ghost" aria-label="Close" data-close-modal="delete-modal"><%- icon('close') %></button>
    </div>
    <div class="modal-body">
      <p class="small">Type <strong><%= site.name %></strong> to confirm.</p>
      <div class="field">
        <input type="text" id="delete-confirm" placeholder="<%= site.name %>" autocomplete="off">
      </div>
      <div class="check">
        <input type="checkbox" id="delete-files" checked>
        <div>
          <label for="delete-files">Also delete the site files</label>
          <div class="hint">Unchecked, <code class="inline"><%= dirs.root %></code> is left on disk.</div>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" data-close-modal="delete-modal">Cancel</button>
      <button class="btn btn-danger" id="delete-confirm-btn">Delete permanently</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="template-modal">
  <div class="modal">
    <div class="modal-head"><h3>Save as preset</h3><button class="btn btn-sm btn-ghost" aria-label="Close" data-close-modal="template-modal"><%- icon('close') %></button></div>
    <div class="modal-body">
      <p class="muted small">Remembers this site's runtime, commands, limits, environment variables and container
        options so you can start the next site from them. The name, domain, port and database are not included.</p>
      <div class="field"><label for="tpl-name">Preset name</label><input id="tpl-name" type="text" placeholder="Node app with Postgres env"></div>
      <div class="field"><label for="tpl-desc">Short description (optional)</label><input id="tpl-desc" type="text"></div>
    </div>
    <div class="modal-foot">
      <button class="btn" data-close-modal="template-modal">Cancel</button>
      <button class="btn btn-primary" id="tpl-save">Save preset</button>
    </div>
  </div>
</div>

<script>
  var SITE_ID = <%= site.id %>;
  var REACHABLE = <%- jsonScript(live.reachable !== false) %>;

  /* ---------------------------------------------------------- actions */
  // The tab bar's buttons are handled in app.js, so every site tab has them.
  // Only page-local action buttons are bound here - binding both would fire
  // each action twice.
  document.querySelectorAll('[data-action]:not([data-site-actions] [data-action])').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var action = btn.getAttribute('data-action');
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Working...';
      try {
        var res = await HP.api('/sites/' + SITE_ID + '/action/' + action);
        if (res.background) {
          HP.toast(action + ' started', 'ok');
          showProgress();
        } else {
          HP.toast(action + ' done', 'ok');
          setTimeout(function () { location.reload(); }, 700);
        }
      } catch (err) {
        HP.toast(err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

  var depsInstall = document.getElementById('deps-install');
  if (depsInstall) {
    depsInstall.addEventListener('click', async function () {
      depsInstall.disabled = true;
      try {
        await HP.api('/sites/' + SITE_ID + '/action/install');
        HP.toast('Installing dependencies', 'ok');
        showProgress();
      } catch (err) {
        HP.toast(err.message, 'error');
        depsInstall.disabled = false;
      }
    });
  }

  /* --------------------------------------------------------- settings */
  document.getElementById('settings-form').addEventListener('submit', async function (e) {
    e.preventDefault();
    var form = new FormData(e.target);
    var payload = {};
    form.forEach(function (v, k) { payload[k] = v; });
    try {
      var res = await HP.api('/sites/' + SITE_ID + '/settings', { body: payload });
      HP.toast(res.message || 'Saved', 'ok');
    } catch (err) {
      HP.toast(err.message, 'error');
    }
  });

  /* ------------------------------------------------------------ proxy */
  function bindProxy(id, body, label) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('click', async function () {
      el.disabled = true;
      var original = el.textContent;
      el.textContent = 'Talking to NPMplus...';
      var url = '/sites/' + SITE_ID + (id === 'proxy-delete' ? '/proxy/delete' : '/proxy');

      var send = async function (payload) {
        var res = await HP.api(url, { body: payload });
        HP.toast(label + ' ok', 'ok');
        setTimeout(function () { location.reload(); }, 800);
      };

      try {
        await send(body);
      } catch (err) {
        var existing = err.data && err.data.existingProxy;
        if (existing) {
          // Never repoint someone else's proxy host without asking.
          var ok = await HP.confirm({
            title: 'That domain is already proxied',
            message: 'NPMplus proxy host #' + existing.id + ' currently forwards ' +
              existing.domains.join(', ') + ' to ' + existing.forward + '.\n\n' +
              'Taking it over repoints it at this site. Whatever it serves now will stop working.',
            confirmText: 'Take it over',
            danger: true
          });
          if (ok) {
            try {
              var adoptBody = {};
              for (var k in body) adoptBody[k] = body[k];
              adoptBody.adopt = true;
              await send(adoptBody);
              return;
            } catch (err2) {
              HP.toast(err2.message, 'error');
            }
          }
        } else {
          HP.toast(err.message, 'error');
        }
        el.disabled = false;
        el.textContent = original;
      }
    });
  }
  bindProxy('proxy-sync', { ssl: true }, 'Proxy host synced');
  bindProxy('proxy-sync-nossl', { ssl: false }, 'Proxy host synced');
  bindProxy('proxy-delete', {}, 'Proxy host removed');

  /* ----------------------------------------------------------- delete */
  document.getElementById('delete-confirm-btn').addEventListener('click', async function () {
    var btn = this;
    btn.disabled = true;
    try {
      var res = await HP.api('/sites/' + SITE_ID + '/delete', {
        body: {
          confirm: document.getElementById('delete-confirm').value,
          delete_files: document.getElementById('delete-files').checked
        }
      });
      location.href = res.redirect || '/';
    } catch (err) {
      HP.toast(err.message, 'error');
      btn.disabled = false;
    }
  });

  /* --------------------------------------------------------- preview */
  var frame = document.getElementById('preview-frame');
  if (frame) {
    var iframe = document.getElementById('preview-iframe');

    document.querySelectorAll('[data-size]').forEach(function (b) {
      b.addEventListener('click', function () {
        var size = b.getAttribute('data-size');
        frame.className = 'preview-frame size-' + size;
        document.querySelectorAll('[data-size]').forEach(function (other) {
          other.setAttribute('aria-pressed', String(other === b));
        });
        try { localStorage.setItem('hp-preview-size', size); } catch (e) { /* ignore */ }
      });
    });

    // Remember the chosen width between visits.
    try {
      var saved = localStorage.getItem('hp-preview-size');
      if (saved) {
        var btn = document.querySelector('[data-size="' + saved + '"]');
        if (btn) btn.click();
      }
    } catch (e) { /* ignore */ }

    /**
     * Says something when the preview stays blank.
     *
     * A white rectangle is the least informative failure in the panel: the
     * site could be down, unreachable, or blocked from being framed, and they
     * look identical. The server already knows whether anything answers on the
     * port, so the two cases can at least be told apart in words.
     */
    var loaded = false;
    iframe.addEventListener('load', function () { loaded = true; });

    setTimeout(function () {
      if (loaded) return;
      var note = document.getElementById('preview-note-live');
      note.style.display = '';
      note.innerHTML = REACHABLE
        ? 'The site is answering on port <code><%= site.port %></code>, but the browser ' +
          'did not render it here. Try <strong>New tab</strong> - if it loads there, ' +
          'something is stopping this page from embedding it.'
        : 'Nothing is answering on port <code><%= site.port %></code> yet, so there is ' +
          'nothing to show. Check the <a href="/sites/<%= site.id %>/logs">Logs</a> tab.';
    }, 5000);

    document.getElementById('preview-reload').addEventListener('click', function () {
      // Re-assigning src re-requests the page; a cache-buster avoids a stale render.
      var base = iframe.src.split('#')[0].split('?')[0];
      iframe.src = base + '?_=' + Date.now();
    });

    // Hiding must be reversible and must survive a reload, or the preview is
    // simply gone and the only way back is to guess that it is a stored setting.
    var card = document.getElementById('preview-card');
    var show = document.getElementById('preview-show');

    function setPreviewHidden(hidden) {
      card.style.display = hidden ? 'none' : '';
      show.style.display = hidden ? '' : 'none';
      try { localStorage.setItem('hp-preview-hidden', hidden ? '1' : '0'); } catch (e) { /* ignore */ }
    }

    document.getElementById('preview-hide').addEventListener('click', function () {
      setPreviewHidden(true);
    });
    show.addEventListener('click', function () {
      setPreviewHidden(false);
      // Reload on reveal: whatever it showed before is likely out of date.
      var base = iframe.src.split('#')[0].split('?')[0];
      iframe.src = base + '?_=' + Date.now();
    });

    try {
      if (localStorage.getItem('hp-preview-hidden') === '1') setPreviewHidden(true);
    } catch (e) { /* ignore */ }
  }

  /* ---------------------------------------------------------- preset */
  var tplSave = document.getElementById('tpl-save');
  if (tplSave) {
    tplSave.addEventListener('click', async function () {
      try {
        var res = await HP.api('/sites/' + SITE_ID + '/save-template', {
          body: {
            name: document.getElementById('tpl-name').value,
            description: document.getElementById('tpl-desc').value
          }
        });
        HP.toast('Saved preset "' + res.template.name + '"', 'ok');
        HP.closeModal('template-modal');
      } catch (err) { HP.toast(err.message, 'error'); }
    });
  }

  /* ----------------------------------------------------- port checks */
  var portField = document.getElementById('s-port');
  var portFeedback = document.getElementById('port-feedback');
  if (portField) {
    var portTimer = null;
    portField.addEventListener('input', function () {
      clearTimeout(portTimer);
      portFeedback.innerHTML = '';
      if (!portField.value.trim()) return;
      portTimer = setTimeout(async function () {
        try {
          var res = await fetch('/api/ports/check?site=' + SITE_ID + '&port=' + encodeURIComponent(portField.value),
            { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
          portFeedback.innerHTML = res.ok
            ? '<div class="field-ok">Port ' + res.port + ' is free. Apply changes to move the site onto it.</div>'
            : '<div class="field-bad">' + HP.escapeHtml(res.error) + '</div>';
        } catch (_) { /* transient */ }
      }, 400);
    });
  }

  /* --------------------------------------------------------- progress */
  var progressSource = null;
  var reloadScheduled = false;

  function showProgress() {
    document.getElementById('progress-card').style.display = '';
    var out = document.getElementById('progress-console');
    out.textContent = '';

    // Drop ?provisioning=1 immediately. Without this, the reload below lands
    // back on a URL that reopens the stream, which finishes instantly because
    // nothing is running, which reloads again - a permanent reload loop.
    if (location.search.indexOf('provisioning=1') !== -1) {
      history.replaceState({}, '', location.pathname);
    }

    if (progressSource) progressSource.close();
    progressSource = new EventSource('/sites/' + SITE_ID + '/progress');

    // The server says up front whether work is actually in flight. Only a run
    // we watched from busy to finished is worth reloading for.
    var wasBusy = false;
    progressSource.addEventListener('state', function (ev) {
      try { wasBusy = !!JSON.parse(ev.data).busy; } catch (_) { /* ignore */ }
    });

    progressSource.onmessage = function (ev) {
      try {
        var line = JSON.parse(ev.data);
        out.textContent += line.line + '\n';
        out.scrollTop = out.scrollHeight;
      } catch (_) { /* ignore */ }
    };

    progressSource.addEventListener('done', function () {
      progressSource.close();
      progressSource = null;
      if (wasBusy && !reloadScheduled) {
        reloadScheduled = true;
        setTimeout(function () { location.reload(); }, 1200);
      }
    });

    progressSource.onerror = function () { /* SSE retries automatically */ };
  }
  <% if (provisioning) { %>showProgress();<% } %>

  /* ------------------------------------------------------- live stats */
  setInterval(async function () {
    try {
      var data = await fetch('/api/status?site=' + SITE_ID + '&stats=1', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      var mine = (data.sites || [])[0];
      if (!mine) return;
      var pill = document.getElementById('state-pill');
      pill.className = 'pill pill-' + mine.state;
      pill.innerHTML = '<span class="dot"></span>' + mine.state;

      // The warning is only true while the container really is absent.
      var missing = document.getElementById('missing-alert');
      if (missing && mine.state !== 'missing') missing.remove();
      if (mine.stats) {
        document.getElementById('stat-cpu').textContent = mine.stats.cpuPercent + ' %';
        document.getElementById('stat-mem').textContent = Math.round(mine.stats.memoryBytes / 1048576) + ' MB';
      }
    } catch (_) { /* transient */ }
  }, 8000);
</script>
<%- include('partials/foot') %>
