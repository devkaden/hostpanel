<%- include('partials/head') %>
<% if (!forced) { %><%- include('partials/nav') %><% } %>
<div class="<%= forced ? 'auth-wrap' : 'wrap wrap-narrow' %>">
  <div class="<%= forced ? 'auth-card' : 'card' %>">
    <% if (forced) { %><div class="auth-logo auth-logo-default"><img src="/static/logo.svg?v=<%= assetVersion %>" alt=""></div><% } %>
    <h1 style="font-size:1.2rem;margin:0 0 1rem;<%= forced ? 'text-align:center' : '' %>">Change password</h1>

    <% if (notice) { %><div class="alert alert-warn"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="current_password">Current Password</label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required autofocus>
      </div>
      <div class="field">
        <label for="new_password">New Password</label>
        <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="10" required>
        <div class="hint">At least 10 characters.</div>
      </div>
      <div class="field">
        <label for="confirm_password">Confirm New Password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="10" required>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" type="submit">Update Password</button>
        <% if (!forced) { %><a class="btn" href="/">Cancel</a><% } %>
      </div>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
