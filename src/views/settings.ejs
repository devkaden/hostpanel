<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap">
  <div class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="sub">Panel configuration, the NPMplus connection and host details.</p>
    </div>
  </div>

  <% if (saved) { %><div class="alert alert-ok">Settings saved.</div><% } %>

  <div class="settings-nav" role="tablist">
    <button type="button" class="active" data-settings-tab="general">
      <%- icon('settings') %><span>General</span>
    </button>
    <button type="button" data-settings-tab="security">
      <%- icon('shield') %><span>Security</span>
    </button>
    <button type="button" data-settings-tab="proxy">
      <%- icon('globe') %><span>Reverse Proxy</span>
    </button>
    <button type="button" data-settings-tab="system">
      <%- icon('install') %><span>System</span>
    </button>
  </div>

  <div class="settings-body">
      <form method="post" action="/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="card" data-settings-section="general">
          <h2>Panel</h2>
          <div class="field">
            <label for="panel_title">Panel Name</label>
            <input id="panel_title" name="panel_title" type="text" value="<%= settings.panel_title %>">
            <div class="hint">Shown top-left and in the browser tab.</div>
          </div>
          <div class="field">
            <label for="host_ip">Host IP for Reverse Proxying</label>
            <div style="display:flex;gap:.5rem">
              <input id="host_ip" name="host_ip" type="text" value="<%= settings.host_ip %>" placeholder="192.168.1.50">
              <button class="btn" type="button" id="detect-ip">Detect</button>
            </div>
            <div class="hint">
              The address NPMplus forwards traffic to. Detected on this machine: <code class="inline"><%= detectedIp || 'none' %></code>.
              If NPMplus runs on another host, this must be an address that host can reach.
            </div>
          </div>
          <div class="field">
            <label for="panel_port">
              Panel port
              <span class="help" data-help="The port this control panel itself listens on. Changing it takes effect after a restart, and the address in your browser changes with it."></span>
            </label>
            <input id="panel_port" name="panel_port" type="number" min="1" max="65535" value="<%= settings.panel_port %>" placeholder="<%= effectivePanelPort %> (from .env)">
            <div class="hint">Leave blank to keep using the value from <code class="inline">.env</code>. Restart the panel after changing it.</div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="port_range_start">
                Site ports from
                <span class="help" data-help="The pool HostPanel picks from when it assigns a port to a new site."></span>
              </label>
              <input id="port_range_start" name="port_range_start" type="number" min="1024" max="65535" value="<%= portRange.start %>">
            </div>
            <div class="field">
              <label for="port_range_end">To</label>
              <input id="port_range_end" name="port_range_end" type="number" min="1024" max="65535" value="<%= portRange.end %>">
            </div>
          </div>

          <div class="check">
            <input type="checkbox" id="allow_host_shell" name="allow_host_shell" <%= settings.allow_host_shell === '1' ? 'checked' : '' %>>
            <div>
              <label for="allow_host_shell">Allow the Host Shell for Administrators</label>
              <div class="hint">
                Gives admins a root-level shell on this machine through the browser.
                <% if (!hostShellSupported) { %>Currently unavailable: the optional <code class="inline">node-pty</code> package is not installed.<% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="card" data-settings-section="security">
          <h2>Security</h2>
          <p class="muted small">
            These matter most when the panel is reachable from outside your own network.
          </p>

          <div class="field">
            <label for="require_2fa">
              Require two-factor authentication
              <span class="help" data-help="Accounts covered by this must set up an authenticator app before they can use the panel. They are prompted automatically at their next sign-in."></span>
            </label>
            <select id="require_2fa" name="require_2fa">
              <option value="off" <%= settings.require_2fa === 'off' ? 'selected' : '' %>>Optional - each person decides</option>
              <option value="admins" <%= settings.require_2fa === 'admins' ? 'selected' : '' %>>Required for administrators</option>
              <option value="all" <%= settings.require_2fa === 'all' ? 'selected' : '' %>>Required for everyone</option>
            </select>
          </div>

          <div class="field">
            <label for="max_upload_mb">
              Maximum Upload Size
              <span class="help" data-help="The largest single file the file manager will accept, in megabytes. Leave blank to use the value from .env. Applies immediately."></span>
            </label>
            <input id="max_upload_mb" name="max_upload_mb" type="number" min="1" max="20480"
                   value="<%= settings.max_upload_mb || '' %>"
                   placeholder="<%= Math.round(config.maxUploadBytes / 1024 / 1024) %> (from .env)">
            <div class="hint">Megabytes. Blank uses the value in <code>.env</code>.</div>
          </div>

          <div class="field">
            <label for="rate_limit_profile">
              Request Limit
              <span class="help" data-help="A ceiling on how many requests one account, or one address before sign-in, may make per minute. It never affects a build log or a terminal session, which are one long request each."></span>
            </label>
            <select id="rate_limit_profile" name="rate_limit_profile">
              <option value="relaxed" <%= settings.rate_limit_profile === 'relaxed' ? 'selected' : '' %>>Relaxed - a panel only you reach</option>
              <option value="standard" <%= (settings.rate_limit_profile || 'standard') === 'standard' ? 'selected' : '' %>>Standard - accounts you handed out</option>
              <option value="strict" <%= settings.rate_limit_profile === 'strict' ? 'selected' : '' %>>Strict - the panel is being probed</option>
            </select>
            <div class="hint">Someone over the limit is told to wait, not signed out. Sign-in has its own
              separate lockout that this does not change.</div>
          </div>

          <div class="field">
            <label for="min_password_length">Minimum Password Length</label>
            <input id="min_password_length" name="min_password_length" type="number" min="8" max="128"
                   value="<%= settings.min_password_length || '10' %>">
            <div class="hint">Applies the next time someone changes their password.</div>
          </div>

          <h3 class="mt">How This Install Stands</h3>
          <ul class="seclist">
            <% security.items.forEach(function (item) { %>
              <li class="<%= item.ok === true ? 'ok' : (item.ok === false ? 'bad' : (item.warn ? 'warn' : 'info')) %>">
                <span class="seclist-icon">
                  <%- item.ok === true ? icon('check') : (item.ok === false ? icon('alert') : icon('shield')) %>
                </span>
                <div>
                  <strong><%= item.label %></strong>
                  <div class="muted small"><%= item.detail %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>

        <div class="card" data-settings-section="general">
          <h2>Appearance</h2>

          <div class="field-row">
            <div class="field">
              <label for="theme">Colour Theme</label>
              <select id="theme" name="theme">
                <option value="system" <%= settings.theme === 'system' ? 'selected' : '' %>>Match the device</option>
                <option value="dark" <%= settings.theme === 'dark' ? 'selected' : '' %>>Always dark</option>
                <option value="light" <%= settings.theme === 'light' ? 'selected' : '' %>>Always light</option>
              </select>
              <div class="hint">Anyone can override this for themselves with the toggle in the top bar.</div>
            </div>
            <div class="field">
              <label for="ui_mode">
                Default detail level
                <span class="help" data-help="Simple hides container names, images, resource limits and other Docker internals. Everyone can switch for themselves at any time."></span>
              </label>
              <select id="ui_mode" name="ui_mode">
                <option value="simple" <%= settings.ui_mode === 'simple' ? 'selected' : '' %>>Simple</option>
                <option value="advanced" <%= settings.ui_mode === 'advanced' ? 'selected' : '' %>>Advanced</option>
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="brand_accent">Accent Colour</label>
              <div style="display:flex;gap:.5rem;align-items:center">
                <input type="color" id="accent_picker" value="<%= settings.brand_accent || '#4f8cff' %>" style="width:44px;padding:2px;height:36px">
                <input id="brand_accent" name="brand_accent" type="text" value="<%= settings.brand_accent || '#4f8cff' %>" placeholder="#4f8cff">
              </div>
            </div>
            <div class="field">
              <label for="brand_logo">
                Logo
                <span class="help" data-help="A small square image for the top-left corner. Paste a path like /static/logo.png, or a data: URL."></span>
              </label>
              <input id="brand_logo" name="brand_logo" type="text" value="<%= settings.brand_logo %>" placeholder="/static/logo.png">
            </div>
          </div>
        </div>

        <div class="card" data-settings-section="proxy">
          <div class="card-head">
            <h2>NPMplus</h2>
            <span class="pill <%= settings.npmplus_enabled === '1' ? 'pill-running' : '' %>"><%= settings.npmplus_enabled === '1' ? 'enabled' : 'disabled' %></span>
          </div>

          <div class="check">
            <input type="checkbox" id="npmplus_enabled" name="npmplus_enabled" <%= settings.npmplus_enabled === '1' ? 'checked' : '' %>>
            <div>
              <label for="npmplus_enabled">Manage Reverse Proxy Hosts Automatically</label>
              <div class="hint">When on, creating a site with a domain also creates the proxy host and requests a certificate.</div>
            </div>
          </div>

          <div class="field">
            <label for="npmplus_url">NPMplus URL</label>
            <input id="npmplus_url" name="npmplus_url" type="text" value="<%= settings.npmplus_url %>" placeholder="https://npm.example.com:81">
            <div class="hint">The admin interface URL, including the port. No trailing slash.</div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="npmplus_email">Admin Email</label>
              <input id="npmplus_email" name="npmplus_email" type="text" value="<%= settings.npmplus_email %>" autocomplete="off">
            </div>
            <div class="field">
              <label for="npmplus_password">Admin Password</label>
              <input id="npmplus_password" name="npmplus_password" type="password" value="<%= settings.npmplus_password %>" autocomplete="new-password">
              <div class="hint">Leave as-is to keep the stored password.</div>
            </div>
          </div>

          <div class="field">
            <label for="npmplus_le_email">Let's Encrypt Email</label>
            <input id="npmplus_le_email" name="npmplus_le_email" type="text" value="<%= settings.npmplus_le_email %>" placeholder="you@example.com">
            <div class="hint">Used for expiry notices on certificates the panel requests. Falls back to the admin email.</div>
          </div>

          <div class="field">
            <label>NPMplus Certificate</label>
            <div id="cert-pin">
              <% if (pinnedCert) { %>
                <div class="pin-card<%= pinnedCert.expired ? ' pin-bad' : '' %>">
                  <div class="pin-head">
                    <%- icon(pinnedCert.expired ? 'alert' : 'shield') %>
                    <strong><%= pinnedCert.expired ? 'The trusted certificate has expired' : 'Trusting one certificate' %></strong>
                  </div>
                  <dl class="dl">
                    <dt>Issued To</dt><dd><%= pinnedCert.subject %></dd>
                    <dt>Fingerprint</dt><dd class="mono small"><%= pinnedCert.fingerprint %></dd>
                    <dt>Expires</dt><dd><%= pinnedCert.validTo %></dd>
                  </dl>
                  <div class="btn-row">
                    <button class="btn btn-sm" type="button" id="cert-trust">Fetch It Again</button>
                    <button class="btn btn-sm btn-danger" type="button" id="cert-forget">Stop Trusting It</button>
                  </div>
                </div>
              <% } else { %>
                <p class="muted small" style="margin:0 0 .5rem">
                  The panel verifies the NPMplus certificate like any other. If NPMplus signed its own
                  &mdash; which is usual on a homelab &mdash; fetch it, check the fingerprint, and the
                  panel will trust that one certificate and no other.
                </p>
                <div class="btn-row">
                  <button class="btn btn-sm" type="button" id="cert-trust">
                    <%- icon('shield') %><span>Trust This Certificate</span>
                  </button>
                  <button class="btn btn-sm adv" type="button" id="cert-paste">Paste It Instead</button>
                </div>
              <% } %>
            </div>
            <div id="cert-result" class="mt"></div>
            <div class="field adv mt" id="cert-paste-field" style="display:none">
              <label for="cert-pem">Certificate (PEM)</label>
              <textarea id="cert-pem" rows="6" spellcheck="false"
                        placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----"></textarea>
              <div class="hint">
                On the NPMplus host:
                <code class="inline">openssl s_client -connect &lt;host&gt;:&lt;port&gt; &lt;/dev/null | openssl x509</code>
              </div>
              <div class="btn-row">
                <button class="btn btn-sm" type="button" id="cert-save-pem">Trust This Certificate</button>
              </div>
            </div>
          </div>

          <div class="btn-row">
            <button class="btn" type="button" id="test-npm">Test Connection</button>
          </div>
          <div id="test-result" class="mt"></div>
        </div>

        <div class="settings-save" data-settings-save>
          <span class="muted small">Changes apply on save. Some need Apply Changes on each site.</span>
          <button class="btn btn-primary" type="submit">
            <%- icon('check') %><span>Save Settings</span>
          </button>
        </div>
      </form>

      <div class="card" data-settings-section="system">
        <div class="card-head">
          <h2>Docker</h2>
          <span class="pill <%= docker.ok ? 'pill-running' : 'pill-error' %>"><%= docker.ok ? 'connected' : 'unavailable' %></span>
        </div>
        <% if (docker.ok) { %>
          <dl class="dl">
            <dt>Server Version</dt><dd><%= dockerInfo.version %></dd>
            <dt>Containers</dt><dd><%= dockerInfo.running %> running / <%= dockerInfo.containers %> total</dd>
            <dt>Images</dt><dd><%= dockerInfo.images %></dd>
            <dt>Host CPUs</dt><dd><%= dockerInfo.cpus %></dd>
            <dt>Host Memory</dt><dd><%= dockerMem %></dd>
          </dl>
        <% } else { %>
          <div class="alert alert-error mb0">
            <%= docker.error %><br>
            Check that the socket exists and that the panel's user is in the <code class="inline">docker</code> group.
          </div>
        <% } %>
      </div>

      <div class="card" data-settings-section="system">
        <h2>Paths and Ports</h2>
        <dl class="dl">
          <dt>Data Directory</dt><dd><code class="inline"><%= dataDir %></code></dd>
          <dt>Site Directories</dt><dd><code class="inline"><%= config.sitesDir %>/&lt;name&gt;</code></dd>
          <dt>Panel Port</dt><dd><%= config.port %></dd>
          <dt>Site Port Range</dt><dd><%= config.portRangeStart %> - <%= config.portRangeEnd %></dd>
          <dt>Max Upload</dt><dd><%= Math.round(config.maxUploadBytes / 1048576) %> MB</dd>
        </dl>
      </div>

      <div class="card" data-settings-section="general">
        <div class="card-head">
          <h2>Saved Presets</h2>
          <span class="muted small"><%= templates.length %></span>
        </div>
        <% if (!templates.length) { %>
          <p class="muted small mb0">None yet. Open any site, press <strong>Save as preset</strong>, and its
            setup becomes a starting point for the next one.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th style="width:90px">Type</th><th style="width:70px"></th></tr></thead>
              <tbody>
                <% templates.forEach(function (t) { %>
                  <tr>
                    <td><%= t.name %><% if (t.description) { %><div class="muted small"><%= t.description %></div><% } %></td>
                    <td><%= t.type %></td>
                    <td class="right">
                      <button class="btn btn-sm btn-danger" data-template-delete="<%= t.id %>"
                              data-template-name="<%= t.name %>" title="Delete this preset">
                        <%- icon('trash') %>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="card" data-settings-section="general">
        <h2>Setup Guide</h2>
        <p class="muted small">Walks through the host address, the reverse proxy connection and your first site.</p>
        <button class="btn" type="button" id="rerun-setup">Run the Setup Guide Again</button>
      </div>

      <div class="card" data-settings-section="proxy">
        <div class="card-head">
          <h2>Check Every Site's Proxy Host</h2>
          <div class="btn-row" style="margin:0">
            <button class="btn btn-sm" type="button" id="proxy-check-all">
              <%- icon('search') %><span>Check All</span>
            </button>
            <button class="btn btn-sm btn-primary" type="button" id="proxy-fix-all">
              <%- icon('shield') %><span>Check &amp; Fix All</span>
            </button>
          </div>
        </div>
        <p class="muted small">
          Compares every site against its proxy host in NPMplus and reports what does not match -
          a forwarding port that moved, a domain added here but never there, a host that was turned
          off. <strong>Check &amp; Fix All</strong> then corrects them. Certificates are left alone;
          request those from the site's own page.
        </p>
        <div id="proxy-check-result" class="mt"></div>
      </div>

      <div class="card" data-settings-section="proxy">
        <div class="card-head">
          <h2>NPMplus Proxy Hosts</h2>
          <button class="btn btn-sm" id="load-hosts">Load</button>
        </div>
        <div id="hosts-list" class="muted small">Click Load to list the proxy hosts NPMplus currently knows about.</div>
      </div>
  </div>
</div>

<script>
  /* --------------------------------------------------- section tabs --
     Settings was one long column of unrelated cards. Grouping them means
     four short pages instead of one page nobody reads to the end of. The
     choice is remembered, because whoever is here for the proxy settings
     is usually coming back to the proxy settings. */
  (function () {
    var buttons = document.querySelectorAll('[data-settings-tab]');
    var sections = document.querySelectorAll('[data-settings-section]');

    // The System tab is read-only, so a Save button there has nothing to do
    // and only gets in the way.
    var EDITABLE = ['general', 'security', 'proxy'];
    var saveBar = document.querySelector('[data-settings-save]');

    function show(name) {
      sections.forEach(function (card) {
        card.style.display = card.getAttribute('data-settings-section') === name ? '' : 'none';
      });
      if (saveBar) saveBar.style.display = EDITABLE.indexOf(name) === -1 ? 'none' : '';
      buttons.forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-settings-tab') === name);
      });
      try { localStorage.setItem('hp-settings-tab', name); } catch (e) { /* ignore */ }
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () { show(b.getAttribute('data-settings-tab')); });
    });

    var saved = 'general';
    try { saved = localStorage.getItem('hp-settings-tab') || 'general'; } catch (e) { /* ignore */ }
    // A remembered tab that no longer exists would leave a blank page.
    if (!document.querySelector('[data-settings-tab="' + saved + '"]')) saved = 'general';
    show(saved);
  })();

  // Keep the colour picker and the hex field in step.
  var picker = document.getElementById('accent_picker');
  var hex = document.getElementById('brand_accent');
  if (picker && hex) {
    picker.addEventListener('input', function () {
      hex.value = picker.value;
      document.documentElement.style.setProperty('--accent', picker.value);
    });
    hex.addEventListener('input', function () {
      if (/^#[0-9a-f]{6}$/i.test(hex.value)) {
        picker.value = hex.value;
        document.documentElement.style.setProperty('--accent', hex.value);
      }
    });
  }

  document.querySelectorAll('[data-template-delete]').forEach(function (b) {
    b.addEventListener('click', function () {
      deleteTemplate(b.getAttribute('data-template-delete'), b.getAttribute('data-template-name'));
    });
  });

  async function deleteTemplate(id, name) {
    var ok = await HP.confirm({
      title: 'Delete this preset?',
      message: 'Sites already created from "' + name + '" are not affected.',
      confirmText: 'Delete preset',
      danger: true
    });
    if (!ok) return;
    try {
      await HP.api('/api/templates/' + id + '/delete');
      HP.toast('Preset deleted', 'ok');
      setTimeout(function () { location.reload(); }, 400);
    } catch (err) { HP.toast(err.message, 'error'); }
  }

  document.getElementById('rerun-setup').addEventListener('click', async function () {
    try {
      var res = await HP.api('/setup/restart', { body: {} });
      location.href = res.redirect || '/setup';
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  document.getElementById('detect-ip').addEventListener('click', async function () {
    try {
      var res = await HP.api('/settings/detect-ip', { body: {} });
      if (res.ip) { document.getElementById('host_ip').value = res.ip; HP.toast('Detected ' + res.ip, 'ok'); }
      else HP.toast('Could not detect an address', 'error');
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  document.getElementById('test-npm').addEventListener('click', async function () {
    var btn = this;
    var box = document.getElementById('test-result');
    btn.disabled = true;
    box.innerHTML = '<div class="alert alert-info mb0">Contacting NPMplus...</div>';
    try {
      var res = await HP.api('/settings/npmplus/test', {
        body: {
          npmplus_url: document.getElementById('npmplus_url').value,
          npmplus_email: document.getElementById('npmplus_email').value,
          npmplus_password: document.getElementById('npmplus_password').value,
          npmplus_url: document.getElementById('npmplus_url').value
        }
      });
      if (res.ok) {
        box.innerHTML = '<div class="alert alert-ok mb0">Connected to ' + HP.escapeHtml(res.url) +
          (res.version ? ' (' + HP.escapeHtml(res.version) + ')' : '') +
          ' &middot; ' + res.proxyHosts + ' proxy host(s) visible' +
          (res.authMode ? ' &middot; auth via ' + HP.escapeHtml(res.authMode) : '') + '.</div>';
      } else {
        var STEP = {
          reach: 'Step 1 — reaching the API',
          auth: 'Step 2 — signing in',
          read: 'Step 3 — reading proxy hosts'
        };
        box.innerHTML = '<div class="alert alert-error mb0">' +
          (res.step ? '<strong>' + STEP[res.step] + ' failed.</strong><br>' : '') +
          HP.escapeHtml(res.error) + '</div>';
      }
    } catch (err) {
      box.innerHTML = '<div class="alert alert-error mb0">' + HP.escapeHtml(err.message) + '</div>';
    }
    btn.disabled = false;
  });

  /* --------------------------------------------- check every proxy host */
  (function () {
    var box = document.getElementById('proxy-check-result');
    if (!box) return;

    async function run(fix, btn) {
      var others = document.querySelectorAll('#proxy-check-all, #proxy-fix-all');
      others.forEach(function (b) { b.disabled = true; });
      btn.setAttribute('data-busy', '1');
      box.innerHTML = '<span class="muted small">Asking NPMplus about every site...</span>';
      try {
        var res = await HP.api('/api/npmplus/check-all', { body: { fix: fix } });
        render(res);
      } catch (err) {
        box.innerHTML = '<div class="alert alert-error mb0">' + HP.escapeHtml(err.message) + '</div>';
      }
      others.forEach(function (b) { b.disabled = false; });
      btn.removeAttribute('data-busy');
    }

    function render(res) {
      if (!res.results.length) {
        box.innerHTML = '<div class="alert alert-info mb0">No site has a domain yet, ' +
          'so there is nothing to proxy.</div>';
        return;
      }
      var rows = res.results.map(function (r) {
        var lines = (r.fixed.length ? r.fixed : r.issues).map(function (t) {
          return '<li>' + HP.escapeHtml(t) + '</li>';
        }).join('');
        var pill = r.error
          ? '<span class="pill pill-error">Failed</span>'
          : r.fixed.length
            ? '<span class="pill pill-running">Fixed</span>'
            : r.issues.length
              ? '<span class="pill pill-starting">Needs fixing</span>'
              : '<span class="pill pill-running">OK</span>';
        return '<tr><td><a href="/sites/' + r.id + '">' + HP.escapeHtml(r.name) + '</a></td>' +
          '<td>' + pill + '</td><td class="small">' +
          (r.error ? '<span class="muted">' + HP.escapeHtml(r.error) + '</span>'
                   : (lines ? '<ul style="margin:0;padding-left:1.1rem">' + lines + '</ul>'
                            : '<span class="muted">Matches this site.</span>')) +
          '</td></tr>';
      }).join('');

      var summary = res.fixed
        ? res.problems + ' of ' + res.checked + ' site' + (res.checked === 1 ? '' : 's') + ' needed work.'
        : res.problems + ' of ' + res.checked + ' site' + (res.checked === 1 ? '' : 's') + ' does not match.';

      box.innerHTML = '<p class="small" style="margin:0 0 .6rem">' + HP.escapeHtml(summary) + '</p>' +
        '<div class="table-wrap"><table><thead><tr><th>Site</th><th style="width:130px">Result</th>' +
        '<th>Detail</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
    }

    document.getElementById('proxy-check-all').addEventListener('click', function () {
      run(false, this);
    });
    document.getElementById('proxy-fix-all').addEventListener('click', async function () {
      var btn = this;
      var ok = await HP.confirm({
        title: 'Fix every proxy host?',
        message: 'Each site\'s proxy host will be corrected to match the site: domains, ' +
          'forwarding address and port, WebSocket upgrades. Proxy hosts the panel did not ' +
          'create are left alone.',
        confirmText: 'Check and fix'
      });
      if (ok) run(true, btn);
    });
  })();

  /* ------------------------------------------- the NPMplus certificate */
  (function () {
    var box = document.getElementById('cert-result');
    if (!box) return;

    function say(kind, html) {
      box.innerHTML = '<div class="alert alert-' + kind + ' mb0">' + html + '</div>';
    }

    function describe(cert) {
      return '<div><strong>' + HP.escapeHtml(cert.subject) + '</strong>' +
        (cert.selfSigned ? ' <span class="muted">(signed by itself)</span>' : '') + '</div>' +
        '<div class="mono small" style="margin:.35rem 0">' + HP.escapeHtml(cert.fingerprint) + '</div>' +
        '<div class="muted small">Expires ' + HP.escapeHtml(cert.validTo) + '</div>';
    }

    async function save(pem) {
      var res = await HP.api('/settings/npmplus/certificate/trust', { body: { pem: pem } });
      HP.toast('Now trusting that certificate', 'ok');
      setTimeout(function () { location.reload(); }, 900);
      return res;
    }

    var trustBtn = document.getElementById('cert-trust');
    if (trustBtn) {
      trustBtn.addEventListener('click', async function () {
        trustBtn.disabled = true;
        trustBtn.setAttribute('data-busy', '1');
        say('info', 'Asking ' + HP.escapeHtml(document.getElementById('npmplus_url').value) +
          ' what certificate it is using...');
        try {
          var res = await HP.api('/settings/npmplus/certificate/fetch', {
            body: { npmplus_url: document.getElementById('npmplus_url').value }
          });
          var cert = res.cert;

          /*
           * A certificate that already verifies needs no pin, and pinning one
           * would break the panel at its next renewal - silently, weeks later.
           */
          if (cert.alreadyTrusted === true) {
            say('ok',
              '<strong>Nothing to do here.</strong> That certificate is signed by an authority ' +
              'this machine already trusts (' + HP.escapeHtml(cert.issuer) + '), so the panel ' +
              'verifies it the ordinary way.' +
              (cert.daysLeft !== null && cert.daysLeft < 120
                ? ' It is also short-lived and will be replaced in about ' + cert.daysLeft +
                  ' days, which is exactly the kind of certificate that must not be pinned.'
                : ''));
            trustBtn.disabled = false;
            trustBtn.removeAttribute('data-busy');
            return;
          }

          // Shown before it is trusted, never after: the fingerprint is the
          // whole point, and it is only worth anything if somebody looks.
          var warning = '';
          if (!cert.selfSigned) {
            warning = '\n\nNote: this certificate was not signed by itself, so it was probably ' +
              'issued by an authority and will be replaced when it renews. Pinning it means the ' +
              'panel stops connecting on that day.';
          } else if (cert.daysLeft !== null && cert.daysLeft < 60) {
            warning = '\n\nNote: it expires in ' + cert.daysLeft + ' days. The panel will stop ' +
              'connecting then until you trust the replacement.';
          }

          var ok = await HP.confirm({
            title: 'Trust this certificate?',
            message: 'NPMplus at that address is using:\n\n' + cert.subject +
              '\nIssued by: ' + cert.issuer +
              '\nFingerprint: ' + cert.fingerprint +
              '\nExpires: ' + cert.validTo + '\n\n' +
              'Check that fingerprint against the one your browser shows for NPMplus. From then ' +
              'on the panel accepts this certificate and no other.' + warning,
            confirmText: 'Trust it'
          });
          if (ok) await save(cert.pem);
          else say('info', 'Nothing was changed.');
        } catch (err) {
          say('error', HP.escapeHtml(err.message));
        }
        trustBtn.disabled = false;
        trustBtn.removeAttribute('data-busy');
      });
    }

    var pasteBtn = document.getElementById('cert-paste');
    if (pasteBtn) {
      pasteBtn.addEventListener('click', function () {
        var field = document.getElementById('cert-paste-field');
        field.style.display = field.style.display === 'none' ? '' : 'none';
      });
    }

    var savePem = document.getElementById('cert-save-pem');
    if (savePem) {
      savePem.addEventListener('click', async function () {
        try { await save(document.getElementById('cert-pem').value); }
        catch (err) { say('error', HP.escapeHtml(err.message)); }
      });
    }

    var forget = document.getElementById('cert-forget');
    if (forget) {
      forget.addEventListener('click', async function () {
        var ok = await HP.confirm({
          title: 'Stop trusting it?',
          message: 'The panel will verify the NPMplus certificate the ordinary way. If NPMplus ' +
            'signed its own, the connection will stop working until you trust it again.',
          confirmText: 'Stop trusting it',
          danger: true
        });
        if (!ok) return;
        try {
          await HP.api('/settings/npmplus/certificate/forget');
          HP.toast('No longer trusting it', 'ok');
          setTimeout(function () { location.reload(); }, 900);
        } catch (err) { say('error', HP.escapeHtml(err.message)); }
      });
    }
  })();

  document.getElementById('load-hosts').addEventListener('click', async function () {
    var box = document.getElementById('hosts-list');
    box.textContent = 'Loading...';
    try {
      var data = await fetch('/api/npmplus/proxy-hosts', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      if (data.error) throw new Error(data.error);
      if (!data.hosts.length) { box.textContent = 'NPMplus has no proxy hosts.'; return; }
      box.innerHTML = '<div class="table-wrap"><table><thead><tr><th>Domains</th><th>Forwards To</th><th>SSL</th></tr></thead><tbody>' +
        data.hosts.map(function (h) {
          return '<tr><td>' + HP.escapeHtml(h.domains.join(', ')) + '</td><td class="mono small">' + HP.escapeHtml(h.forward) + '</td><td>' +
            (h.ssl ? '<span class="pill pill-ssl">yes</span>' : '<span class="pill">no</span>') + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    } catch (err) {
      box.innerHTML = '<div class="alert alert-error mb0">' + HP.escapeHtml(err.message) + '</div>';
    }
  });
</script>
<%- include('partials/foot') %>
