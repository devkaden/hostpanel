<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap">
  <div class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="sub">Panel configuration, the NPMplus connection and host details.</p>
    </div>
  </div>

  <% if (saved) { %><div class="alert alert-ok">Settings saved.</div><% } %>

  <div class="grid grid-2">
    <div>
      <form method="post" action="/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="card">
          <h2>Panel</h2>
          <div class="field">
            <label for="panel_title">Panel name</label>
            <input id="panel_title" name="panel_title" type="text" value="<%= settings.panel_title %>">
            <div class="hint">Shown top-left and in the browser tab.</div>
          </div>
          <div class="field">
            <label for="host_ip">Host IP for reverse proxying</label>
            <div style="display:flex;gap:.5rem">
              <input id="host_ip" name="host_ip" type="text" value="<%= settings.host_ip %>" placeholder="192.168.1.50">
              <button class="btn" type="button" id="detect-ip">Detect</button>
            </div>
            <div class="hint">
              The address NPMplus forwards traffic to. Detected on this machine: <code class="inline"><%= detectedIp || 'none' %></code>.
              If NPMplus runs on another host, this must be an address that host can reach.
            </div>
          </div>
          <div class="field">
            <label for="panel_port">
              Panel port
              <span class="help" data-help="The port this control panel itself listens on. Changing it takes effect after a restart, and the address in your browser changes with it."></span>
            </label>
            <input id="panel_port" name="panel_port" type="number" min="1" max="65535" value="<%= settings.panel_port %>" placeholder="<%= effectivePanelPort %> (from .env)">
            <div class="hint">Leave blank to keep using the value from <code class="inline">.env</code>. Restart the panel after changing it.</div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="port_range_start">
                Site ports from
                <span class="help" data-help="The pool HostPanel picks from when it assigns a port to a new site."></span>
              </label>
              <input id="port_range_start" name="port_range_start" type="number" min="1024" max="65535" value="<%= portRange.start %>">
            </div>
            <div class="field">
              <label for="port_range_end">to</label>
              <input id="port_range_end" name="port_range_end" type="number" min="1024" max="65535" value="<%= portRange.end %>">
            </div>
          </div>

          <div class="check">
            <input type="checkbox" id="allow_host_shell" name="allow_host_shell" <%= settings.allow_host_shell === '1' ? 'checked' : '' %>>
            <div>
              <label for="allow_host_shell">Allow the host shell for administrators</label>
              <div class="hint">
                Gives admins a root-level shell on this machine through the browser.
                <% if (!hostShellSupported) { %>Currently unavailable: the optional <code class="inline">node-pty</code> package is not installed.<% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2>Appearance</h2>

          <div class="field-row">
            <div class="field">
              <label for="theme">Colour theme</label>
              <select id="theme" name="theme">
                <option value="system" <%= settings.theme === 'system' ? 'selected' : '' %>>Match the device</option>
                <option value="dark" <%= settings.theme === 'dark' ? 'selected' : '' %>>Always dark</option>
                <option value="light" <%= settings.theme === 'light' ? 'selected' : '' %>>Always light</option>
              </select>
              <div class="hint">Anyone can override this for themselves with the toggle in the top bar.</div>
            </div>
            <div class="field">
              <label for="ui_mode">
                Default detail level
                <span class="help" data-help="Simple hides container names, images, resource limits and other Docker internals. Everyone can switch for themselves at any time."></span>
              </label>
              <select id="ui_mode" name="ui_mode">
                <option value="simple" <%= settings.ui_mode === 'simple' ? 'selected' : '' %>>Simple</option>
                <option value="advanced" <%= settings.ui_mode === 'advanced' ? 'selected' : '' %>>Advanced</option>
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="brand_accent">Accent colour</label>
              <div style="display:flex;gap:.5rem;align-items:center">
                <input type="color" id="accent_picker" value="<%= settings.brand_accent || '#4f8cff' %>" style="width:44px;padding:2px;height:36px">
                <input id="brand_accent" name="brand_accent" type="text" value="<%= settings.brand_accent || '#4f8cff' %>" placeholder="#4f8cff">
              </div>
            </div>
            <div class="field">
              <label for="brand_logo">
                Logo
                <span class="help" data-help="A small square image for the top-left corner. Paste a path like /static/logo.png, or a data: URL."></span>
              </label>
              <input id="brand_logo" name="brand_logo" type="text" value="<%= settings.brand_logo %>" placeholder="/static/logo.png">
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <h2>NPMplus</h2>
            <span class="pill <%= settings.npmplus_enabled === '1' ? 'pill-running' : '' %>"><%= settings.npmplus_enabled === '1' ? 'enabled' : 'disabled' %></span>
          </div>

          <div class="check">
            <input type="checkbox" id="npmplus_enabled" name="npmplus_enabled" <%= settings.npmplus_enabled === '1' ? 'checked' : '' %>>
            <div>
              <label for="npmplus_enabled">Manage reverse proxy hosts automatically</label>
              <div class="hint">When on, creating a site with a domain also creates the proxy host and requests a certificate.</div>
            </div>
          </div>

          <div class="field">
            <label for="npmplus_url">NPMplus URL</label>
            <input id="npmplus_url" name="npmplus_url" type="text" value="<%= settings.npmplus_url %>" placeholder="https://npm.example.com:81">
            <div class="hint">The admin interface URL, including the port. No trailing slash.</div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="npmplus_email">Admin email</label>
              <input id="npmplus_email" name="npmplus_email" type="text" value="<%= settings.npmplus_email %>" autocomplete="off">
            </div>
            <div class="field">
              <label for="npmplus_password">Admin password</label>
              <input id="npmplus_password" name="npmplus_password" type="password" value="<%= settings.npmplus_password %>" autocomplete="new-password">
              <div class="hint">Leave as-is to keep the stored password.</div>
            </div>
          </div>

          <div class="field">
            <label for="npmplus_le_email">Let's Encrypt email</label>
            <input id="npmplus_le_email" name="npmplus_le_email" type="text" value="<%= settings.npmplus_le_email %>" placeholder="you@example.com">
            <div class="hint">Used for expiry notices on certificates the panel requests. Falls back to the admin email.</div>
          </div>

          <div class="check">
            <input type="checkbox" id="npmplus_insecure" name="npmplus_insecure" <%= settings.npmplus_insecure === '1' ? 'checked' : '' %>>
            <div>
              <label for="npmplus_insecure">Allow a self-signed certificate on the NPMplus admin interface</label>
              <div class="hint">Only affects the panel's API calls to NPMplus, not your sites.</div>
            </div>
          </div>

          <div class="btn-row">
            <button class="btn" type="button" id="test-npm">Test connection</button>
          </div>
          <div id="test-result" class="mt"></div>
        </div>

        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save settings</button>
        </div>
      </form>
    </div>

    <div>
      <div class="card">
        <div class="card-head">
          <h2>Docker</h2>
          <span class="pill <%= docker.ok ? 'pill-running' : 'pill-error' %>"><%= docker.ok ? 'connected' : 'unavailable' %></span>
        </div>
        <% if (docker.ok) { %>
          <dl class="dl">
            <dt>Server version</dt><dd><%= dockerInfo.version %></dd>
            <dt>Containers</dt><dd><%= dockerInfo.running %> running / <%= dockerInfo.containers %> total</dd>
            <dt>Images</dt><dd><%= dockerInfo.images %></dd>
            <dt>Host CPUs</dt><dd><%= dockerInfo.cpus %></dd>
            <dt>Host memory</dt><dd><%= dockerMem %></dd>
          </dl>
        <% } else { %>
          <div class="alert alert-error mb0">
            <%= docker.error %><br>
            Check that the socket exists and that the panel's user is in the <code class="inline">docker</code> group.
          </div>
        <% } %>
      </div>

      <div class="card">
        <h2>Paths and ports</h2>
        <dl class="dl">
          <dt>Data directory</dt><dd><code class="inline"><%= dataDir %></code></dd>
          <dt>Site directories</dt><dd><code class="inline"><%= config.sitesDir %>/&lt;name&gt;</code></dd>
          <dt>Panel port</dt><dd><%= config.port %></dd>
          <dt>Site port range</dt><dd><%= config.portRangeStart %> - <%= config.portRangeEnd %></dd>
          <dt>Max upload</dt><dd><%= Math.round(config.maxUploadBytes / 1048576) %> MB</dd>
        </dl>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>Saved presets</h2>
          <span class="muted small"><%= templates.length %></span>
        </div>
        <% if (!templates.length) { %>
          <p class="muted small mb0">None yet. Open any site, press <strong>Save as preset</strong>, and its
            setup becomes a starting point for the next one.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th style="width:90px">Type</th><th style="width:70px"></th></tr></thead>
              <tbody>
                <% templates.forEach(function (t) { %>
                  <tr>
                    <td><%= t.name %><% if (t.description) { %><div class="muted small"><%= t.description %></div><% } %></td>
                    <td><%= t.type %></td>
                    <td class="right">
                      <button class="btn btn-sm btn-danger" onclick="deleteTemplate(<%= t.id %>, <%= JSON.stringify(t.name) %>)">Del</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="card">
        <h2>Setup guide</h2>
        <p class="muted small">Walks through the host address, the reverse proxy connection and your first site.</p>
        <button class="btn" type="button" id="rerun-setup">Run the setup guide again</button>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>NPMplus proxy hosts</h2>
          <button class="btn btn-sm" id="load-hosts">Load</button>
        </div>
        <div id="hosts-list" class="muted small">Click load to list the proxy hosts NPMplus currently knows about.</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Keep the colour picker and the hex field in step.
  var picker = document.getElementById('accent_picker');
  var hex = document.getElementById('brand_accent');
  if (picker && hex) {
    picker.addEventListener('input', function () {
      hex.value = picker.value;
      document.documentElement.style.setProperty('--accent', picker.value);
    });
    hex.addEventListener('input', function () {
      if (/^#[0-9a-f]{6}$/i.test(hex.value)) {
        picker.value = hex.value;
        document.documentElement.style.setProperty('--accent', hex.value);
      }
    });
  }

  async function deleteTemplate(id, name) {
    var ok = await HP.confirm({
      title: 'Delete this preset?',
      message: 'Sites already created from "' + name + '" are not affected.',
      confirmText: 'Delete preset',
      danger: true
    });
    if (!ok) return;
    try {
      await HP.api('/api/templates/' + id + '/delete');
      HP.toast('Preset deleted', 'ok');
      setTimeout(function () { location.reload(); }, 400);
    } catch (err) { HP.toast(err.message, 'error'); }
  }

  document.getElementById('rerun-setup').addEventListener('click', async function () {
    try {
      var res = await HP.api('/setup/restart', { body: {} });
      location.href = res.redirect || '/setup';
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  document.getElementById('detect-ip').addEventListener('click', async function () {
    try {
      var res = await HP.api('/settings/detect-ip', { body: {} });
      if (res.ip) { document.getElementById('host_ip').value = res.ip; HP.toast('Detected ' + res.ip, 'ok'); }
      else HP.toast('Could not detect an address', 'error');
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  document.getElementById('test-npm').addEventListener('click', async function () {
    var btn = this;
    var box = document.getElementById('test-result');
    btn.disabled = true;
    box.innerHTML = '<div class="alert alert-info mb0">Contacting NPMplus...</div>';
    try {
      var res = await HP.api('/settings/npmplus/test', {
        body: {
          npmplus_url: document.getElementById('npmplus_url').value,
          npmplus_email: document.getElementById('npmplus_email').value,
          npmplus_password: document.getElementById('npmplus_password').value,
          npmplus_insecure: document.getElementById('npmplus_insecure').checked
        }
      });
      if (res.ok) {
        box.innerHTML = '<div class="alert alert-ok mb0">Connected to ' + HP.escapeHtml(res.url) +
          (res.version ? ' (' + HP.escapeHtml(res.version) + ')' : '') +
          ' &middot; ' + res.proxyHosts + ' proxy host(s) visible' +
          (res.authMode ? ' &middot; auth via ' + HP.escapeHtml(res.authMode) : '') + '.</div>';
      } else {
        var STEP = {
          reach: 'Step 1 — reaching the API',
          auth: 'Step 2 — signing in',
          read: 'Step 3 — reading proxy hosts'
        };
        box.innerHTML = '<div class="alert alert-error mb0">' +
          (res.step ? '<strong>' + STEP[res.step] + ' failed.</strong><br>' : '') +
          HP.escapeHtml(res.error) + '</div>';
      }
    } catch (err) {
      box.innerHTML = '<div class="alert alert-error mb0">' + HP.escapeHtml(err.message) + '</div>';
    }
    btn.disabled = false;
  });

  document.getElementById('load-hosts').addEventListener('click', async function () {
    var box = document.getElementById('hosts-list');
    box.textContent = 'Loading...';
    try {
      var data = await fetch('/api/npmplus/proxy-hosts', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      if (data.error) throw new Error(data.error);
      if (!data.hosts.length) { box.textContent = 'NPMplus has no proxy hosts.'; return; }
      box.innerHTML = '<div class="table-wrap"><table><thead><tr><th>Domains</th><th>Forwards to</th><th>SSL</th></tr></thead><tbody>' +
        data.hosts.map(function (h) {
          return '<tr><td>' + HP.escapeHtml(h.domains.join(', ')) + '</td><td class="mono small">' + HP.escapeHtml(h.forward) + '</td><td>' +
            (h.ssl ? '<span class="pill pill-ssl">yes</span>' : '<span class="pill">no</span>') + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    } catch (err) {
      box.innerHTML = '<div class="alert alert-error mb0">' + HP.escapeHtml(err.message) + '</div>';
    }
  });
</script>
<%- include('partials/foot') %>
