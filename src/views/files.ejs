<%- include('partials/head') %>
<link rel="stylesheet" href="/vendor/codemirror/lib/codemirror.css">
<link rel="stylesheet" href="/vendor/codemirror/theme/material-darker.css">
<%- include('partials/nav') %>

<div class="wrap">
  <div class="page-head">
    <div>
      <h1><%= site.name %> &middot; Files</h1>
      <p class="sub">Drag files or folders anywhere on this page to upload them. Drag rows onto a folder to move them.</p>
    </div>
    <div class="page-actions">
      <button class="btn" id="new-folder-btn"><%- icon('folder') %><span>New Folder</span></button>
      <button class="btn" id="new-file-btn"><%- icon('file') %><span>New File</span></button>
      <button class="btn btn-primary" id="upload-btn"><%- icon('upload') %><span>Upload Files</span></button>
      <button class="btn" id="upload-folder-btn"><%- icon('folder') %><span>Upload Folder</span></button>
    </div>
  </div>

  <%- include('partials/site-tabs') %>

  <div class="crumbs" id="crumbs"></div>

  <div class="fm-toolbar">
    <div class="fm-search-wrap">
      <%- icon('search', 'fm-search-icon') %>
      <input type="text" id="filter" placeholder="Filter this folder" autocomplete="off">
    </div>
    <span class="muted small" id="folder-summary"></span>
    <div class="spacer"></div>
    <span class="muted small" id="selection-count"></span>
    <button class="btn btn-sm" id="bulk-download" style="display:none">
      <%- icon('download') %><span>Download</span>
    </button>
    <button class="btn btn-sm btn-danger" id="bulk-delete" style="display:none">
      <%- icon('trash') %><span>Delete</span>
    </button>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="table-wrap">
      <table class="fm-table">
        <thead>
          <tr>
            <th style="width:34px"><input type="checkbox" id="check-all" style="width:auto" aria-label="Select all"></th>
            <th class="sortable" data-sort="name">Name <span class="arrow" data-arrow="name"></span></th>
            <th class="sortable" style="width:110px" data-sort="size">Size <span class="arrow" data-arrow="size"></span></th>
            <th class="sortable" style="width:150px" data-sort="mtime">Modified <span class="arrow" data-arrow="mtime"></span></th>
            <th style="width:72px" class="adv">Mode</th>
            <th style="width:250px" class="right">Actions</th>
          </tr>
        </thead>
        <tbody id="file-rows">
          <tr><td colspan="6" class="muted" style="padding:1.5rem">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="upload-bar" id="upload-bar">
    <div class="upload-track"><div class="upload-fill" id="upload-fill"></div></div>
    <div class="muted small mt" id="upload-label"></div>
  </div>

  <input type="file" id="file-input" multiple style="display:none">
  <input type="file" id="folder-input" webkitdirectory directory multiple style="display:none">
  <p class="muted small mt">
    Up to <%= maxUploadMb %> MB per file. Files land in the folder you are viewing.
    <button class="btn btn-sm btn-ghost" id="copy-cmd">
      <%- icon('terminal') %><span>Copy From Your Computer</span>
    </button>
  </p>
</div>

<div class="drop-overlay" id="drop-overlay">
  <div class="inner">
    <strong>Drop to upload</strong>
    <span id="drop-target-label">into this folder</span>
  </div>
</div>

<!-- ------------------------------------------------------------ modals -->
<div class="modal-backdrop" id="name-modal">
  <div class="modal">
    <div class="modal-head"><h3 id="name-modal-title">New Folder</h3><button class="btn btn-sm btn-ghost" aria-label="Close" data-close-modal="name-modal"><%- icon('close') %></button></div>
    <div class="modal-body">
      <div class="field">
        <label for="name-input" id="name-modal-label">Folder Name</label>
        <input id="name-input" type="text" autocomplete="off">
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" data-close-modal="name-modal">Cancel</button>
      <button class="btn btn-primary" id="name-go">Create</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="editor-modal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3 id="editor-title">Edit</h3>
      <button class="btn btn-sm btn-ghost" aria-label="Close" id="editor-close"><%- icon('close') %></button>
    </div>
    <div class="modal-body" style="padding:.5rem .7rem">
      <div class="editor-shell">
        <div class="editor-toolbar">
          <div class="editor-status">
            <span id="editor-lang">text</span>
            <span id="editor-pos">Ln 1, Col 1</span>
            <span id="editor-size"></span>
            <span id="editor-dirty" class="editor-dirty"></span>
          </div>
          <div class="spacer"></div>
          <button class="btn btn-sm" id="editor-wrap">Wrap: off</button>
          <span class="muted small">Ctrl/Cmd+S saves &middot; Ctrl/Cmd+F finds</span>
        </div>
        <textarea id="editor-area" class="editor-area" spellcheck="false"></textarea>
      </div>
    </div>
    <div class="modal-foot">
      <span class="muted small" id="editor-msg"></span>
      <div class="spacer"></div>
      <button class="btn" id="editor-cancel">Close</button>
      <button class="btn btn-primary" id="editor-save">Save</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="image-modal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3 id="image-title">Image</h3>
      <button class="btn btn-sm btn-ghost" data-close-modal="image-modal" aria-label="Close">
        <%- icon('close') %>
      </button>
    </div>
    <div class="modal-body image-body">
      <img id="image-view" alt="">
    </div>
    <div class="modal-foot">
      <span class="muted small" id="image-meta"></span>
      <div class="spacer"></div>
      <a class="btn" id="image-download" download><%- icon('download') %><span>Download</span></a>
      <button class="btn" data-close-modal="image-modal">Close</button>
    </div>
  </div>
</div>

<script src="/vendor/codemirror/lib/codemirror.js"></script>
<script src="/vendor/codemirror/mode/htmlmixed/htmlmixed.js"></script>
<script src="/vendor/codemirror/mode/xml/xml.js"></script>
<script src="/vendor/codemirror/mode/javascript/javascript.js"></script>
<script src="/vendor/codemirror/mode/css/css.js"></script>
<script src="/vendor/codemirror/mode/php/php.js"></script>
<script src="/vendor/codemirror/mode/clike/clike.js"></script>
<script src="/vendor/codemirror/mode/markdown/markdown.js"></script>
<script src="/vendor/codemirror/mode/yaml/yaml.js"></script>
<script src="/vendor/codemirror/mode/shell/shell.js"></script>
<script src="/vendor/codemirror/mode/sql/sql.js"></script>
<script src="/vendor/codemirror/mode/nginx/nginx.js"></script>
<!-- dockerfile mode is built on defineSimpleMode, which lives in this addon.
     Without it the mode file throws on load and takes the rest of the
     script block with it. -->
<script src="/vendor/codemirror/addon/mode/simple.js"></script>
<script src="/vendor/codemirror/mode/dockerfile/dockerfile.js"></script>
<script src="/vendor/codemirror/mode/python/python.js"></script>
<script src="/vendor/codemirror/addon/search/search.js"></script>
<script src="/vendor/codemirror/addon/search/searchcursor.js"></script>
<script src="/vendor/codemirror/addon/dialog/dialog.js"></script>
<script src="/vendor/codemirror/addon/edit/closebrackets.js"></script>
<script src="/vendor/codemirror/addon/edit/matchbrackets.js"></script>
<link rel="stylesheet" href="/vendor/codemirror/addon/dialog/dialog.css">

<script>
  var SITE_ID = <%= site.id %>;
  // The rows are built in JavaScript, so the icon markup is handed over from
  // the server rather than duplicating the icon set in two places.
  var ICONS = <%- jsonScript({
    folder: icon('folder'),
    image: icon('image'),
    emptyFolder: icon('folder', 'ico-lg'),
  }) %>;
  var current = <%- jsonScript(listing.path || '') %>;
  var SITE_NAME = <%- jsonScript(site.name) %>;

  var items = [];
  var sortKey = 'name';
  var sortDir = 1;
  var lastClickedIndex = null;

  function api(p, opts) { return HP.api('/api/sites/' + SITE_ID + '/files' + p, opts); }

  /* =================================================== listing ========= */
  async function load(path) {
    current = path || '';
    history.replaceState({}, '', '/sites/' + SITE_ID + '/files?path=' + encodeURIComponent(current));
    document.getElementById('drop-target-label').textContent =
      current ? 'into /' + current : 'into the site root';

    var data;
    try {
      data = await fetch('/api/sites/' + SITE_ID + '/files?path=' + encodeURIComponent(current),
        { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
    } catch (err) {
      HP.toast('Could not open that folder', 'error');
      return;
    }
    if (data.error) { HP.toast(data.error, 'error'); return; }

    items = data.items;
    renderCrumbs(data.path);
    render(data);
  }

  function renderCrumbs(path) {
    var parts = path ? path.split('/') : [];
    var el = document.getElementById('crumbs');
    el.innerHTML = '';

    var root = document.createElement('a');
    root.href = '#';
    root.textContent = SITE_NAME;
    root.setAttribute('data-path', '');
    el.appendChild(root);

    var acc = '';
    parts.forEach(function (p) {
      acc = acc ? acc + '/' + p : p;
      var sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = '/';
      el.appendChild(sep);
      var a = document.createElement('a');
      a.href = '#';
      a.textContent = p;
      a.setAttribute('data-path', acc);
      el.appendChild(a);
    });

    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); load(a.getAttribute('data-path')); });
      // Breadcrumbs are drop targets too, so you can move things up a level.
      makeDropTarget(a, a.getAttribute('data-path'));
    });
  }

  /* Classifies a file for its little type badge. */
  var IMAGE_EXTS = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'avif', 'svg', 'ico', 'bmp'];

  function isImage(item) {
    if (item.type === 'dir') return false;
    return IMAGE_EXTS.indexOf((item.name.split('.').pop() || '').toLowerCase()) !== -1;
  }

  function iconFor(item) {
    if (item.type === 'dir') return { cls: 'dir', svg: ICONS.folder };
    var ext = (item.name.split('.').pop() || '').toLowerCase();
    if (item.name.indexOf('.') === -1) return { cls: 'doc', text: '' };
    if (IMAGE_EXTS.indexOf(ext) !== -1) return { cls: 'img', text: ext };
    if (['zip','tar','gz','tgz','bz2','xz','7z','rar'].indexOf(ext) !== -1) return { cls: 'archive', text: ext };
    if (['html','htm','css','js','mjs','cjs','ts','tsx','jsx','php','py','rb','sh','json','yml','yaml','xml','sql','vue','svelte','conf'].indexOf(ext) !== -1) return { cls: 'code', text: ext };
    return { cls: 'doc', text: ext };
  }

  function sorted(list) {
    var copy = list.slice();
    copy.sort(function (a, b) {
      // Folders always come first, whichever column is sorted.
      if (a.type !== b.type) return a.type === 'dir' ? -1 : 1;
      var av, bv;
      if (sortKey === 'size') { av = a.type === 'dir' ? -1 : a.size; bv = b.type === 'dir' ? -1 : b.size; }
      else if (sortKey === 'mtime') { av = new Date(a.mtime).getTime(); bv = new Date(b.mtime).getTime(); }
      else { return a.name.localeCompare(b.name, undefined, { numeric: true }) * sortDir; }
      return (av - bv) * sortDir;
    });
    return copy;
  }

  function render(data) {
    var tbody = document.getElementById('file-rows');
    var filter = document.getElementById('filter').value.trim().toLowerCase();
    var visible = sorted(items).filter(function (i) {
      return !filter || i.name.toLowerCase().indexOf(filter) !== -1;
    });

    tbody.innerHTML = '';

    if (data && data.parent !== null && data.parent !== undefined && !filter) {
      var up = document.createElement('tr');
      up.innerHTML = '<td></td><td colspan="5"><a href="#" class="nav-up">&larr; up one level</a></td>';
      up.querySelector('.nav-up').addEventListener('click', function (e) {
        e.preventDefault(); load(data.parent);
      });
      makeDropTarget(up, data.parent);
      tbody.appendChild(up);
    }

    if (!visible.length) {
      var empty = document.createElement('tr');
      empty.innerHTML = '<td colspan="6" style="padding:2rem">' +
        (filter
          ? '<div class="empty" style="padding:0"><h3>Nothing Matches "' + HP.escapeHtml(filter) + '"</h3>' +
            '<p>Clear the filter to see everything in this folder.</p></div>'
          : '<div class="empty" style="padding:0"><div class="empty-icon">' + ICONS.emptyFolder + '</div>' +
            '<h3>This Folder Is Empty</h3><p>Drag files or a folder anywhere on this page to upload them.</p></div>') +
        '</td>';
      tbody.appendChild(empty);
      updateSelection();
      updateSummary(visible);
      return;
    }

    visible.forEach(function (item, index) {
      tbody.appendChild(buildRow(item, index));
    });
    updateSelection();
    updateSummary(visible);
  }

  function updateSummary(visible) {
    var dirs = visible.filter(function (i) { return i.type === 'dir'; }).length;
    var files = visible.length - dirs;
    var bytes = visible.reduce(function (n, i) { return n + (i.type === 'file' ? i.size : 0); }, 0);
    document.getElementById('folder-summary').textContent =
      dirs + ' folder' + (dirs === 1 ? '' : 's') + ', ' +
      files + ' file' + (files === 1 ? '' : 's') + ' (' + HP.bytes(bytes) + ')';
  }

  function buildRow(item, index) {
    var tr = document.createElement('tr');
    tr.className = item.type === 'dir' ? 'row-dir' : 'row-file';
    tr.setAttribute('data-path', item.path);
    tr.setAttribute('data-index', String(index));
    tr.draggable = true;

    var icon = iconFor(item);

    var tdCheck = document.createElement('td');
    var cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.className = 'row-check';
    cb.style.width = 'auto';
    cb.setAttribute('data-path', item.path);
    cb.addEventListener('change', function () { updateSelection(); syncRowClass(tr, cb.checked); });
    cb.addEventListener('click', function (e) {
      // Shift-click selects a range, as in a desktop file manager.
      if (e.shiftKey && lastClickedIndex !== null) {
        var rows = Array.prototype.slice.call(document.querySelectorAll('#file-rows tr[data-index]'));
        var from = Math.min(lastClickedIndex, index);
        var to = Math.max(lastClickedIndex, index);
        rows.forEach(function (r) {
          var i = parseInt(r.getAttribute('data-index'), 10);
          if (i >= from && i <= to) {
            var box = r.querySelector('.row-check');
            box.checked = cb.checked;
            syncRowClass(r, box.checked);
          }
        });
        updateSelection();
      }
      lastClickedIndex = index;
    });
    tdCheck.appendChild(cb);

    var tdName = document.createElement('td');
    var wrap = document.createElement('div');
    wrap.className = 'name-cell';
    var badge = document.createElement('span');
    badge.className = 'fm-icon ' + icon.cls;
    if (icon.svg) badge.innerHTML = icon.svg;
    else badge.textContent = icon.text;
    wrap.appendChild(badge);

    if (item.type === 'dir') {
      var a = document.createElement('a');
      a.href = '#';
      a.textContent = item.name;
      a.addEventListener('click', function (e) { e.preventDefault(); load(item.path); });
      wrap.appendChild(a);
    } else if (isImage(item)) {
      var ia = document.createElement('a');
      ia.href = '#';
      ia.className = 'fname';
      ia.textContent = item.name;
      ia.title = 'View this image';
      ia.addEventListener('click', function (e) { e.preventDefault(); openImage(item); });
      wrap.appendChild(ia);
    } else if (item.editable) {
      var ea = document.createElement('a');
      ea.href = '#';
      ea.className = 'fname';
      ea.textContent = item.name;
      ea.title = 'Open in the editor';
      ea.addEventListener('click', function (e) { e.preventDefault(); openEditor(item.path); });
      wrap.appendChild(ea);
    } else {
      var sp = document.createElement('span');
      sp.className = 'fname';
      sp.textContent = item.name;
      wrap.appendChild(sp);
    }
    if (item.symlink) {
      var link = document.createElement('span');
      link.className = 'pill';
      link.textContent = 'link';
      wrap.appendChild(link);
    }
    tdName.appendChild(wrap);

    var tdSize = document.createElement('td');
    tdSize.className = 'muted small';
    tdSize.textContent = item.type === 'dir' ? '-' : HP.bytes(item.size);

    var tdTime = document.createElement('td');
    tdTime.className = 'muted small nowrap';
    tdTime.textContent = HP.relTime(item.mtime);
    tdTime.title = new Date(item.mtime).toLocaleString();

    var tdMode = document.createElement('td');
    tdMode.className = 'muted small mono adv';
    tdMode.textContent = item.mode;

    var tdActions = document.createElement('td');
    tdActions.className = 'right';
    var actions = document.createElement('div');
    actions.className = 'file-actions';

    if (isImage(item)) actions.appendChild(button('View', '', function () { openImage(item); }));
    if (item.editable) actions.appendChild(button('Edit', '', function () { openEditor(item.path); }));
    if (/\.zip$/i.test(item.name)) {
      actions.appendChild(button('Extract', '', async function (btn) {
        btn.disabled = true; btn.textContent = '...';
        try {
          var r = await api('/extract', { body: { path: item.path } });
          HP.toast('Extracted ' + r.files + ' files', 'ok');
          load(current);
        } catch (err) { HP.toast(err.message, 'error'); btn.disabled = false; btn.textContent = 'Extract'; }
      }));
    }

    var dl = document.createElement('a');
    dl.className = 'btn btn-sm';
    dl.href = '/api/sites/' + SITE_ID + '/files/download?path=' + encodeURIComponent(item.path) +
      (item.type === 'dir' ? '&zip=1' : '');
    dl.textContent = item.type === 'dir' ? 'Download zip' : 'Download';
    actions.appendChild(dl);

    actions.appendChild(button('Rename', '', function () { promptRename(item); }));
    actions.appendChild(button('Delete', 'btn-danger', function () { confirmDelete([item.path]); }));

    tdActions.appendChild(actions);

    tr.appendChild(tdCheck);
    tr.appendChild(tdName);
    tr.appendChild(tdSize);
    tr.appendChild(tdTime);
    tr.appendChild(tdMode);
    tr.appendChild(tdActions);

    /* ------------------------------------------------ drag to move ---- */
    tr.addEventListener('dragstart', function (e) {
      // Dragging an unselected row drags just that row; otherwise the selection.
      var paths = selectedPaths();
      if (paths.indexOf(item.path) === -1) paths = [item.path];
      e.dataTransfer.setData('application/x-hostpanel-paths', JSON.stringify(paths));
      e.dataTransfer.effectAllowed = 'move';
      tr.classList.add('dragging');
    });
    tr.addEventListener('dragend', function () {
      tr.classList.remove('dragging');
      document.querySelectorAll('.drop-target').forEach(function (n) { n.classList.remove('drop-target'); });
    });

    if (item.type === 'dir') makeDropTarget(tr, item.path);

    return tr;
  }

  function button(label, cls, onClick) {
    var b = document.createElement('button');
    b.className = 'btn btn-sm ' + (cls || '');
    b.textContent = label;
    b.addEventListener('click', function () { onClick(b); });
    return b;
  }

  function syncRowClass(tr, on) { tr.classList.toggle('selected', on); }

  /* ================================================ drag to move ====== */
  function makeDropTarget(el, destPath) {
    el.addEventListener('dragover', function (e) {
      if (!e.dataTransfer.types || e.dataTransfer.types.indexOf('application/x-hostpanel-paths') === -1) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      el.classList.add('drop-target');
    });
    el.addEventListener('dragleave', function () { el.classList.remove('drop-target'); });
    el.addEventListener('drop', async function (e) {
      if (!e.dataTransfer.types || e.dataTransfer.types.indexOf('application/x-hostpanel-paths') === -1) return;
      e.preventDefault();
      e.stopPropagation();
      el.classList.remove('drop-target');
      var paths;
      try { paths = JSON.parse(e.dataTransfer.getData('application/x-hostpanel-paths')); }
      catch (_) { return; }
      if (!paths || !paths.length) return;

      try {
        var res = await api('/move', { body: { paths: paths, to: destPath } });
        HP.toast('Moved ' + res.moved.length + ' item' + (res.moved.length === 1 ? '' : 's'), 'ok');
        load(current);
      } catch (err) { HP.toast(err.message, 'error'); }
    });
  }

  /* ================================================== selection ======= */
  function selectedPaths() {
    return Array.prototype.slice.call(document.querySelectorAll('.row-check:checked'))
      .map(function (c) { return c.getAttribute('data-path'); });
  }

  function updateSelection() {
    var sel = selectedPaths();
    document.getElementById('selection-count').textContent = sel.length ? sel.length + ' selected' : '';
    document.getElementById('bulk-delete').style.display = sel.length ? '' : 'none';
    document.getElementById('bulk-download').style.display = sel.length ? '' : 'none';
    var all = document.getElementById('check-all');
    var boxes = document.querySelectorAll('.row-check');
    all.checked = boxes.length > 0 && sel.length === boxes.length;
    all.indeterminate = sel.length > 0 && sel.length < boxes.length;
  }

  document.getElementById('check-all').addEventListener('change', function (e) {
    document.querySelectorAll('.row-check').forEach(function (c) {
      c.checked = e.target.checked;
      syncRowClass(c.closest('tr'), c.checked);
    });
    updateSelection();
  });

  document.getElementById('bulk-delete').addEventListener('click', function () {
    confirmDelete(selectedPaths());
  });

  document.getElementById('bulk-download').addEventListener('click', function () {
    selectedPaths().forEach(function (p, i) {
      // Stagger slightly so the browser does not drop concurrent downloads.
      setTimeout(function () {
        var item = items.filter(function (x) { return x.path === p; })[0];
        window.location.href = '/api/sites/' + SITE_ID + '/files/download?path=' +
          encodeURIComponent(p) + (item && item.type === 'dir' ? '&zip=1' : '');
      }, i * 400);
    });
  });

  async function confirmDelete(paths) {
    if (!paths.length) return;
    var ok = await HP.confirm({
      title: paths.length === 1 ? 'Delete this item?' : 'Delete ' + paths.length + ' items?',
      message: 'This cannot be undone.',
      list: paths.slice(0, 12).concat(paths.length > 12 ? ['...and ' + (paths.length - 12) + ' more'] : []),
      confirmText: 'Delete',
      danger: true
    });
    if (!ok) return;
    try {
      await api('/delete', { body: { paths: paths } });
      HP.toast('Deleted', 'ok');
      load(current);
    } catch (err) { HP.toast(err.message, 'error'); }
  }

  /* =================================================== sorting ======== */
  document.querySelectorAll('th.sortable').forEach(function (th) {
    th.addEventListener('click', function () {
      var key = th.getAttribute('data-sort');
      if (sortKey === key) sortDir = -sortDir;
      else { sortKey = key; sortDir = 1; }
      document.querySelectorAll('[data-arrow]').forEach(function (a) { a.textContent = ''; });
      var arrow = document.querySelector('[data-arrow="' + key + '"]');
      if (arrow) arrow.textContent = sortDir === 1 ? '▲' : '▼';
      try { localStorage.setItem('hp-fm-sort', key + ':' + sortDir); } catch (e) { /* ignore */ }
      render(null);
    });
  });

  try {
    var savedSort = localStorage.getItem('hp-fm-sort');
    if (savedSort) {
      sortKey = savedSort.split(':')[0];
      sortDir = parseInt(savedSort.split(':')[1], 10) === -1 ? -1 : 1;
      var a0 = document.querySelector('[data-arrow="' + sortKey + '"]');
      if (a0) a0.textContent = sortDir === 1 ? '▲' : '▼';
    }
  } catch (e) { /* ignore */ }

  document.getElementById('filter').addEventListener('input', function () { render(null); });

  /* ============================================ create and rename ===== */
  var nameMode = 'folder';
  var renameTarget = null;

  function openNameModal(mode, item) {
    nameMode = mode;
    renameTarget = item || null;
    var titles = { folder: 'New folder', file: 'New file', rename: 'Rename' };
    var labels = { folder: 'Folder name', file: 'File name', rename: 'New name' };
    document.getElementById('name-modal-title').textContent = titles[mode];
    document.getElementById('name-modal-label').textContent = labels[mode];
    document.getElementById('name-go').textContent = mode === 'rename' ? 'Rename' : 'Create';
    var input = document.getElementById('name-input');
    input.value = item ? item.name : '';
    HP.openModal('name-modal');
    setTimeout(function () { input.focus(); input.select(); }, 30);
  }

  function promptRename(item) { openNameModal('rename', item); }

  document.getElementById('new-folder-btn').addEventListener('click', function () { openNameModal('folder'); });
  document.getElementById('new-file-btn').addEventListener('click', function () { openNameModal('file'); });

  document.getElementById('name-input').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('name-go').click(); }
  });

  document.getElementById('name-go').addEventListener('click', async function () {
    var value = document.getElementById('name-input').value.trim();
    if (!value) { HP.toast('Enter a name', 'error'); return; }
    try {
      if (nameMode === 'folder') await api('/mkdir', { body: { path: current, name: value } });
      else if (nameMode === 'file') await api('/touch', { body: { path: current, name: value } });
      else await api('/rename', { body: { path: renameTarget.path, name: value } });
      HP.closeModal('name-modal');
      load(current);
    } catch (err) { HP.toast(err.message, 'error'); }
  });

  /* ==================================================== uploads ======= */
  var fileInput = document.getElementById('file-input');
  var folderInput = document.getElementById('folder-input');

  document.getElementById('upload-btn').addEventListener('click', function () { fileInput.click(); });
  document.getElementById('upload-folder-btn').addEventListener('click', function () { folderInput.click(); });
  /**
   * Starts an upload from a file input, and does not clear the input until it
   * has finished.
   *
   * The clearing is what matters. An <input type="file"> is reset after use so
   * that picking the same file twice in a row fires change again - but in
   * WebKit the File objects an input produced stop being readable the moment
   * that input is reset. Clearing it while an upload was still running (the
   * upload is asynchronous; the clear was not waiting for it) revoked access to
   * the very files being sent, and every read came back NotReadableError while
   * the same bytes generated in the page uploaded perfectly. Awaiting the
   * upload first costs nothing and removes the whole class of failure.
   */
  function pickFrom(input, pathOf) {
    input.addEventListener('change', async function () {
      if (!input.files.length) return;
      var picked = Array.prototype.map.call(input.files, function (f) {
        return { file: f, path: pathOf(f) };
      });
      try {
        await uploadFiles(picked);
      } finally {
        input.value = '';
      }
    });
  }

  pickFrom(fileInput, function (f) { return f.name; });
  pickFrom(folderInput, function (f) { return f.webkitRelativePath || f.name; });

  /**
   * Walks a dropped directory tree. The entries API is the only way to read
   * folder structure out of a drop, and it must be traversed before the
   * event's dataTransfer is neutered, so entries are captured synchronously.
   */
  function readEntry(entry, prefix) {
    return new Promise(function (resolve) {
      if (entry.isFile) {
        // Deliberately NOT calling entry.file() here. A File captured during
        // traversal is a snapshot, and Chrome releases access to a dropped
        // folder soon afterwards - the browser then aborts the upload
        // mid-body. Keeping the entry and resolving the File immediately
        // before sending avoids that entirely.
        resolve([{ entry: entry, path: (prefix ? prefix + '/' : '') + entry.name }]);
      } else if (entry.isDirectory) {
        var reader = entry.createReader();
        var all = [];
        var readBatch = function () {
          reader.readEntries(function (batch) {
            if (!batch.length) {
              Promise.all(all.map(function (e) {
                return readEntry(e, (prefix ? prefix + '/' : '') + entry.name);
              })).then(function (groups) {
                resolve(groups.reduce(function (acc, g) { return acc.concat(g); }, []));
              });
              return;
            }
            all = all.concat(Array.prototype.slice.call(batch));
            readBatch(); // readEntries returns at most 100 at a time
          }, function () { resolve([]); });
        };
        readBatch();
      } else {
        resolve([]);
      }
    });
  }

  /** entry.file() can hang without calling either callback. Never wait forever. */
  function entryToFile(entry, ms) {
    return new Promise(function (resolve, reject) {
      var settled = false;
      var timer = setTimeout(function () {
        if (settled) return;
        settled = true;
        reject(new Error('timed out reading the file handle'));
      }, ms || 10000);

      try {
        entry.file(
          function (file) {
            if (settled) return;
            settled = true; clearTimeout(timer); resolve(file);
          },
          function () {
            if (settled) return;
            settled = true; clearTimeout(timer);
            reject(new Error('the browser refused to open the file'));
          }
        );
      } catch (err) {
        if (!settled) { settled = true; clearTimeout(timer); reject(err); }
      }
    });
  }

  /**
   * Reads a File's bytes into memory, and gives up rather than waiting forever.
   *
   * This is the step that makes uploads work at all in Safari. Handing a
   * disk-backed File straight to XMLHttpRequest asks the browser to stream it
   * while the request is open, and Safari can simply never start: the request
   * goes out, no progress event ever fires, no error is raised, and the upload
   * sits there. The same bytes as an in-memory Blob upload instantly. So the
   * reading is done here, where a stall is a normal failure that can be
   * reported, instead of inside a request that has no way to say what is wrong.
   *
   * FileReader rather than file.arrayBuffer() because it can be aborted. A
   * promise from arrayBuffer() that never settles is a leak with no handle on
   * it; a FileReader can be told to stop and release the file.
   */
  function readBytes(file, ms) {
    return new Promise(function (resolve, reject) {
      if (typeof FileReader === 'undefined') {
        // No FileReader: fall back to the modern API, still bounded.
        var timer0 = setTimeout(function () {
          reject(new Error('timed out reading "' + file.name + '"'));
        }, ms || 30000);
        file.arrayBuffer().then(
          function (buf) { clearTimeout(timer0); resolve(new Blob([buf], { type: file.type || '' })); },
          function (err) { clearTimeout(timer0); reject(err); }
        );
        return;
      }

      var reader = new FileReader();
      var settled = false;
      var timer = setTimeout(function () {
        if (settled) return;
        settled = true;
        try { reader.abort(); } catch (_) { /* already finished */ }
        reject(new Error(
          'the browser never finished reading "' + file.name + '". If it is ' +
          'stored in iCloud, OneDrive or Dropbox, download it locally first.'
        ));
      }, ms || 30000);

      reader.onload = function () {
        if (settled) return;
        settled = true; clearTimeout(timer);
        resolve(new Blob([reader.result], { type: file.type || '' }));
      };
      reader.onerror = function () {
        if (settled) return;
        settled = true; clearTimeout(timer);
        reject(new Error(
          'could not read "' + file.name + '"' +
          (reader.error && reader.error.name ? ' (' + reader.error.name + ')' : '')
        ));
      };
      reader.onabort = function () {
        if (settled) return;
        settled = true; clearTimeout(timer);
        reject(new Error('reading "' + file.name + '" was cancelled'));
      };

      try {
        reader.readAsArrayBuffer(file);
      } catch (err) {
        if (!settled) { settled = true; clearTimeout(timer); reject(err); }
      }
    });
  }

  // Materialising a file means reading its bytes into memory up front, so the
  // upload no longer depends on the browser still having access to the
  // original. Bounded so a huge folder cannot exhaust the tab.
  var MATERIALISE_MAX_FILE = 20 * 1024 * 1024;
  var MATERIALISE_BUDGET = 250 * 1024 * 1024;

  /**
   * Reads what it can while access is definitely alive.
   *
   * A dropped folder is only readable for a short window: afterwards Chrome
   * either fails the read (the upload aborts mid-body) or never answers
   * entry.file() at all. Both were happening. Taking the bytes now removes the
   * dependency on that window entirely.
   */
  async function materialise(items, onProgress) {
    var used = 0;
    var consecutiveFailures = 0;

    for (var i = 0; i < items.length; i += 1) {
      var item = items[i];
      onProgress(i, items.length, item.path);
      if (!item.entry || item.blob) continue;

      // Once several files in a row cannot be read, the source itself is gone:
      // a dropped folder whose access has lapsed, or a sync folder that is not
      // answering. Waiting out a ten second timeout on each of two hundred
      // files would take half an hour to reach a conclusion already obvious
      // after three, so the rest are failed immediately with the same reason.
      if (consecutiveFailures >= 3) {
        item.readError = 'the browser stopped answering reads from this folder';
        continue;
      }

      try {
        var file = await entryToFile(item.entry, 10000);
        item.file = file; // a fallback even if the bytes are not held
        if (file.size <= MATERIALISE_MAX_FILE && used + file.size <= MATERIALISE_BUDGET) {
          item.blob = await readBytes(file, 30000);
          used += file.size;
        }
        consecutiveFailures = 0;
      } catch (err) {
        consecutiveFailures += 1;
        item.readError = err.message;
      }
    }
  }

  // Above this, a file is handed to the browser as-is rather than held in
  // memory. Reading a 500 MB file into a tab to upload it is worse than the
  // problem it solves.
  var READ_INTO_MEMORY_MAX = 64 * 1024 * 1024;

  /**
   * The body to send for this item, as in-memory bytes wherever that is sane.
   *
   * Sending the browser's own File object is the obvious thing to do and it is
   * what does not work: Safari accepts the request, reaches readyState 1, and
   * then never sends a byte - no progress, no error, nothing to catch. The
   * identical bytes as an in-memory Blob upload in milliseconds. So the file is
   * read here, where a failure is an ordinary rejected promise that can say
   * which file and why, rather than inside a request with no way to report it.
   *
   * Dropped files were already read during traversal, because their access
   * expires. Picked files are read here instead, one at a time, so a large
   * selection does not sit in memory all at once.
   */
  async function bodyFor(item) {
    if (item.blob) return item.blob;

    var file = item.file;
    if (!file && item.entry) {
      try {
        file = await entryToFile(item.entry, 10000);
      } catch (err) {
        throw new Error(
          'Could not read "' + item.path + '" from disk. Use the Upload folder ' +
          'button instead of dragging - and if the file lives in iCloud, OneDrive ' +
          'or Dropbox, make sure it is downloaded locally first.'
        );
      }
    }
    if (!file) throw new Error('No readable data for ' + item.path);

    // Too big to hold in memory: hand it over and let the watchdog cover it.
    if (file.size > READ_INTO_MEMORY_MAX) return file;

    try {
      return await readBytes(file, 30000);
    } catch (err) {
      // Deliberately not falling back to the handle. If the browser cannot
      // read the file here it cannot read it inside the request either - that
      // path just replaces a clear message with a twenty second stall.
      ulog('read failed', item.path, err.message);
      throw new Error(
        'The browser could not read "' + item.path + '" (' + err.message + ').'
      );
    }
  }

  // Junk that is rebuilt on the server or belongs to version control. Sending
  // it wastes minutes and is exactly what used to blow past the upload limits.
  var SKIP_DIRS = ['node_modules', '.git', '.svn', '.hg', '.next', '.nuxt', '.cache', 'vendor/bin'];
  var SKIP_FILES = ['.DS_Store', 'Thumbs.db', 'desktop.ini'];

  function classify(entries) {
    var keep = [];
    var skipped = { byDir: {}, files: 0 };
    entries.forEach(function (e) {
      var parts = e.path.split('/');
      var name = parts[parts.length - 1];
      var dirHit = null;
      for (var i = 0; i < parts.length - 1; i += 1) {
        if (SKIP_DIRS.indexOf(parts[i]) !== -1) { dirHit = parts[i]; break; }
      }
      if (dirHit) {
        skipped.byDir[dirHit] = (skipped.byDir[dirHit] || 0) + 1;
        return;
      }
      if (SKIP_FILES.indexOf(name) !== -1) { skipped.files += 1; return; }
      keep.push(e);
    });
    return { keep: keep, skipped: skipped };
  }

  /**
   * Uploads one file as a raw PUT. No multipart, so there is no form that can
   * end unexpectedly - a failure names the file it belongs to.
   */
  // Uploads are the one part of this page that fails in ways a screenshot
  // cannot explain: a request that is never sent looks exactly like one that
  // is never answered. Every step says so in the console, so "it hangs" can be
  // narrowed to a line.
  function ulog() {
    try {
      var args = ['[upload]'].concat(Array.prototype.slice.call(arguments));
      console.log.apply(console, args);
    } catch (_) { /* console can be absent in odd embeddings */ }
  }

  function putFile(item, file, onFraction) {
    ulog('sending', item.path, (file && file.size != null) ? file.size + ' bytes' : '');
    return new Promise(function (resolve, reject) {
      var url = '/api/sites/' + SITE_ID + '/files/raw' +
        '?dir=' + encodeURIComponent(current) +
        '&path=' + encodeURIComponent(item.path);

      var xhr = new XMLHttpRequest();
      xhr.open('PUT', url);
      xhr.setRequestHeader('X-CSRF-Token', HP.CSRF);
      xhr.setRequestHeader('Content-Type', 'application/octet-stream');
      xhr.setRequestHeader('Accept', 'application/json');

      // A request that never settles would hold a worker forever and freeze
      // the whole queue behind it. Better to fail this file and move on.
      xhr.timeout = 120000;

      var settled = false;
      var lastLoaded = -1;
      var lastMovedAt = Date.now();
      function done(fn, arg) {
        if (settled) return;
        settled = true;
        clearInterval(stallTimer);
        fn(arg);
      }

      // A request that is neither answered nor failed is the worst outcome:
      // the queue sits at 0% and nothing says why.
      //
      // This watches the byte counter, not the events. Safari fires a progress
      // event with loaded = 0 and then stalls, so treating "an event arrived"
      // as progress disarms the very guard that is needed. Only the number
      // going up counts as movement.
      var STALL_MS = 20000;
      var stallTimer = setInterval(function () {
        if (settled) return;
        if (Date.now() - lastMovedAt < STALL_MS) return;
        ulog('stalled at', lastLoaded < 0 ? 0 : lastLoaded, 'bytes, abandoning', item.path);
        try { xhr.abort(); } catch (_) { /* already gone */ }
        done(reject, new Error(
          'the browser stopped after ' + (lastLoaded < 0 ? 0 : lastLoaded) + ' bytes'
        ));
      }, 2000);

      xhr.upload.addEventListener('progress', function (e) {
        if (e.loaded > lastLoaded) { lastLoaded = e.loaded; lastMovedAt = Date.now(); }
        if (e.lengthComputable && e.total) onFraction(e.loaded / e.total);
      });
      xhr.addEventListener('readystatechange', function () {
        if (xhr.readyState >= 2) lastMovedAt = Date.now(); // a reply is coming
      });

      xhr.addEventListener('load', function () {
        var res = {};
        try { res = JSON.parse(xhr.responseText || '{}'); } catch (_) { res = {}; }
        onFraction(1);
        ulog('response', item.path, xhr.status, xhr.responseText.slice(0, 200));
        if (xhr.status >= 200 && xhr.status < 300) done(resolve, res);
        else done(reject, new Error(res.error || (item.path + ' failed (' + xhr.status + ')')));
      });
      xhr.addEventListener('error', function () {
        ulog('network error', item.path, 'readyState', xhr.readyState);
        done(reject, new Error('The connection dropped while uploading ' + item.path));
      });
      xhr.addEventListener('timeout', function () {
        ulog('client timeout', item.path, 'readyState', xhr.readyState);
        done(reject, new Error(item.path + ' timed out - the upload stalled'));
      });
      xhr.addEventListener('abort', function () {
        done(reject, new Error('the upload was aborted'));
      });

      try {
        xhr.send(file);
      } catch (err) {
        ulog('send threw', item.path, err && err.message);
        done(reject, new Error('Could not read ' + item.path + ' from disk'));
      }
    });
  }

  /**
   * The same upload through fetch() instead of XMLHttpRequest.
   *
   * These are different code paths inside the browser, and they do not fail
   * together. Safari in particular has a long history of XHR upload bugs that
   * fetch does not share - which matters here because a file manager that
   * cannot upload is not a file manager. The cost is progress reporting: fetch
   * cannot report how much of a body has been sent, so this moves the bar in
   * one step at the end.
   */
  async function fetchFile(item, body) {
    var url = '/api/sites/' + SITE_ID + '/files/raw' +
      '?dir=' + encodeURIComponent(current) +
      '&path=' + encodeURIComponent(item.path);

    ulog('retrying with fetch', item.path);
    var res = await fetch(url, {
      method: 'PUT',
      headers: {
        'X-CSRF-Token': HP.CSRF,
        'Content-Type': 'application/octet-stream',
        Accept: 'application/json'
      },
      body: body,
      credentials: 'same-origin'
    });

    var data = {};
    try { data = await res.json(); } catch (_) { data = {}; }
    ulog('fetch response', item.path, res.status);
    if (!res.ok) throw new Error(data.error || (item.path + ' failed (' + res.status + ')'));
    return data;
  }

  /**
   * Uploads one item, and does not give up after one way of doing it.
   *
   * First with XMLHttpRequest, because it reports progress. If that fails for
   * any reason other than the file being unreadable, the same bytes go again
   * through fetch(), which is a different implementation inside the browser
   * and fails differently. A read failure is not retried at all - it will not
   * read any better the second time, and retrying only delays the message that
   * explains it.
   */
  async function uploadOne(item, onFraction) {
    var body = await bodyFor(item);

    try {
      var res = await putFile(item, body, onFraction);
      item.blob = null; // sent: let the bytes go
      return res;
    } catch (err) {
      ulog('xhr failed', item.path, err.message);
      onFraction(0);
      try {
        var out = await fetchFile(item, body);
        onFraction(1);
        item.blob = null;
        return out;
      } catch (err2) {
        item.blob = null;
        // Report the first failure: it is the one with the useful detail.
        throw new Error(err.message + ' (and again via fetch: ' + err2.message + ')');
      }
    }
  }

  /**
   * Reads the dropped files into memory before any upload starts.
   *
   * This is the step that fixes dragged folders. Chrome keeps a dropped
   * directory readable for a short window; past it, entry.file() either fails
   * (the upload aborted mid-body) or never answers at all (the upload never
   * started). Reading during that window removes the dependency on it.
   */
  async function readPhase(entries, label) {
    var needsRead = entries.some(function (e) { return e.entry && !e.blob; });
    if (!needsRead) return;

    await materialise(entries, function (i, n, name) {
      var pct = Math.round((i / n) * 100);
      label.textContent = 'Reading ' + n + ' file' + (n === 1 ? '' : 's') +
        ' - ' + pct + '%' + (name ? ' - ' + name : '');
    });
  }

  async function uploadFiles(entries) {
    if (!entries.length) return;

    // Offer to leave out the folders that should not be uploaded at all.
    var sorted_ = classify(entries);
    var dirNames = Object.keys(sorted_.skipped.byDir);
    if (dirNames.length) {
      var choice = await HP.dialog({
        title: 'Skip build and version-control folders?',
        message: 'These are normally rebuilt on the server or belong to version control, ' +
          'so uploading them wastes time.',
        list: dirNames.map(function (d) {
          return d + ' - ' + sorted_.skipped.byDir[d] + ' files';
        }),
        tone: 'warn',
        confirmText: 'Skip them',
        extraText: 'Upload everything',
        cancelText: 'Cancel'
      });
      if (choice === false || choice === null) return;
      if (choice !== 'extra') entries = sorted_.keep;
    } else if (sorted_.skipped.files) {
      entries = sorted_.keep;
    }

    if (!entries.length) { HP.toast('Nothing left to upload', 'error'); return; }

    // Progress is counted in files rather than bytes: sizes are not known for
    // a dropped folder until each file has actually been opened.
    var total = entries.length;
    var doneCount = 0;
    var failures = [];

    var bar = document.getElementById('upload-bar');
    var fill = document.getElementById('upload-fill');
    var label = document.getElementById('upload-label');
    bar.classList.add('on');
    fill.style.width = '0%';

    // Browsers allow about six connections per host. Staying well under that
    // leaves room for the rest of the panel and avoids queueing behind uploads.
    var CONCURRENCY = 2;
    var fractions = [];
    var inFlight = [];

    function tick() {
      var partial = fractions.reduce(function (n, f) { return n + (f || 0); }, 0);
      var pct = Math.min(100, Math.round(((doneCount + partial) / total) * 100));
      fill.style.width = pct + '%';
      var names = inFlight.filter(Boolean);
      label.textContent = 'Uploading ' + total + ' file' + (total === 1 ? '' : 's') +
        ' - ' + pct + '% (' + doneCount + ' done)' + (names.length ? ' - ' + names[0] : '');
    }
    tick();

    // Read first, upload second. Doing it in this order is what makes a
    // dragged folder work at all.
    try {
      await readPhase(entries, label);
    } catch (_) { /* per-file errors are recorded on the items themselves */ }

    // Anything that could not be read is a failure now, not after a timeout.
    // A file the read phase could not open moments ago will not open now, so
    // it is reported straight away rather than stalling the queue for 10s.
    var unreadable = entries.filter(function (e) {
      if (e.blob || e.file) return false;
      return !e.entry || !!e.readError;
    });
    unreadable.forEach(function (e) {
      failures.push({ name: e.path, error: (e.readError || 'could not be opened') + ' (see below)' });
    });
    entries = entries.filter(function (e) { return unreadable.indexOf(e) === -1; });
    doneCount = failures.length;
    tick();

    var queue = entries.slice();

    async function worker(_unused, slot) {
      while (queue.length) {
        var item = queue.shift();
        inFlight[slot] = item.path;
        fractions[slot] = 0;
        tick();
        try {
          await uploadOne(item, function (f) { fractions[slot] = f; tick(); });
          doneCount += 1;
        } catch (err) {
          failures.push({ name: item.path, error: err.message });
          doneCount += 1; // counted either way, so the bar still completes
        }
        fractions[slot] = 0;
        inFlight[slot] = null;
        tick();
      }
    }

    try {
      await Promise.all(
        Array.apply(null, { length: Math.min(CONCURRENCY, entries.length) }).map(worker)
      );
    } finally {
      bar.classList.remove('on');
    }

    var ok = total - failures.length;
    if (ok) HP.toast('Uploaded ' + ok + ' file' + (ok === 1 ? '' : 's'), 'ok');
    if (failures.length) {
      var readFailed = failures.some(function (f) {
        return /see below|could not read|NotReadableError/i.test(f.error);
      });
      var msg = ok ? 'The rest went through.' : 'Nothing was uploaded.';
      if (readFailed) {
        msg += ' The browser refused to read the files, so nothing was ever sent ' +
          'to the panel - this is between the browser and your disk, not the ' +
          'network. On a Mac the usual cause is Safari not having permission to ' +
          'the folder: System Settings, Privacy & Security, Files and Folders, ' +
          'Safari, and turn on Desktop, Documents and Downloads. Files kept in ' +
          'iCloud, OneDrive or Dropbox must also be downloaded locally first. ' +
          'If neither applies, the "Copy from your computer" button gives you an ' +
          'rsync command that bypasses the browser entirely.';
      }
      await HP.alert({
        title: failures.length === 1 ? 'One file could not be uploaded' :
          failures.length + ' files could not be uploaded',
        message: msg,
        list: failures.slice(0, 10).map(function (f) {
          return f.name + ' - ' + f.error.replace(' (see below)', '');
        }),
        tone: 'danger'
      });
    }
    load(current);
  }

  /**
   * Shows an rsync command that copies a folder straight into this site.
   *
   * Browser uploads depend on the browser being willing to read local files,
   * and that is not always in anyone's gift: macOS can refuse Safari access to
   * Desktop, Documents and Downloads, and no amount of care on this side fixes
   * a file the browser will not open. rsync does not care - it runs as you,
   * over ssh, and it is the faster option for a real project anyway.
   */
  var APP_DIR = <%- jsonScript(dirs.app) %>;
  var HOST_IP = <%- jsonScript(hostIp) %>;

  document.getElementById('copy-cmd').addEventListener('click', function () {
    var host = HOST_IP || location.hostname;
    var target = 'root@' + host + ':' + APP_DIR + '/';
    var cmd = 'rsync -av --exclude node_modules --exclude .git ' +
      '~/path/to/' + SITE_NAME + '/ ' + target;

    HP.alert({
      title: 'Copy files in from your computer',
      message: 'Run this in Terminal on your Mac, with the real path to your ' +
        'project in place of ~/path/to/' + SITE_NAME + '. The trailing slash ' +
        'matters: it copies the contents of the folder rather than the folder ' +
        'itself. Add --delete to remove files here that are gone locally.',
      input: true,
      readonly: true,
      copyValue: cmd,
      value: cmd,
      tone: 'info',
      wide: true,
      confirmText: 'Copy',
      cancelText: 'Close'
    });
  });

  /* ------------------------------------------- whole-page drop zone -- */
  var overlay = document.getElementById('drop-overlay');
  var dragDepth = 0;

  function isFileDrag(e) {
    return e.dataTransfer && e.dataTransfer.types &&
      Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') !== -1;
  }

  window.addEventListener('dragenter', function (e) {
    if (!isFileDrag(e)) return;
    e.preventDefault();
    dragDepth += 1;
    overlay.classList.add('on');
  });
  window.addEventListener('dragover', function (e) {
    if (isFileDrag(e)) e.preventDefault();
  });
  window.addEventListener('dragleave', function (e) {
    if (!isFileDrag(e)) return;
    dragDepth -= 1;
    if (dragDepth <= 0) { dragDepth = 0; overlay.classList.remove('on'); }
  });
  window.addEventListener('drop', async function (e) {
    if (!isFileDrag(e)) return;
    e.preventDefault();
    dragDepth = 0;
    overlay.classList.remove('on');
    var entries = await collectFromDrop(e.dataTransfer);
    if (entries.length) uploadFiles(entries);
  });

  /* ==================================================== editor ======== */
  var editor = null;
  var editTarget = null;
  var savedContent = '';
  var wrapOn = false;

  var MODES = {
    html: 'htmlmixed', htm: 'htmlmixed', vue: 'htmlmixed', svelte: 'htmlmixed',
    css: 'css', scss: 'css', less: 'css',
    js: 'javascript', mjs: 'javascript', cjs: 'javascript', jsx: 'javascript',
    ts: 'javascript', tsx: 'javascript', json: { name: 'javascript', json: true },
    php: 'php', py: 'python', rb: 'text/x-ruby',
    sh: 'shell', bash: 'shell', zsh: 'shell',
    md: 'markdown', markdown: 'markdown',
    yml: 'yaml', yaml: 'yaml',
    sql: 'sql', xml: 'xml', svg: 'xml',
    conf: 'nginx', nginx: 'nginx',
    dockerfile: 'dockerfile'
  };

  function modeFor(name) {
    var lower = name.toLowerCase();
    if (lower === 'dockerfile') return { mode: 'dockerfile', label: 'dockerfile' };
    var ext = (lower.split('.').pop() || '');
    var mode = MODES[ext];
    return { mode: mode || null, label: mode ? ext : 'text' };
  }

  var cmAvailable = typeof CodeMirror !== 'undefined';

  /* ==================================================== image viewer === */
  /**
   * Shows an image in place rather than downloading it to look at it.
   *
   * The download endpoint is reused as the source: it already enforces the
   * per-site path containment, so there is no second way to read a file and no
   * second place for that check to be forgotten.
   */
  function openImage(item) {
    var url = '/api/sites/' + SITE_ID + '/files/download?path=' + encodeURIComponent(item.path);
    var img = document.getElementById('image-view');
    var meta = document.getElementById('image-meta');

    document.getElementById('image-title').textContent = item.name;
    document.getElementById('image-download').href = url;
    document.getElementById('image-download').setAttribute('download', item.name);
    meta.textContent = HP.bytes(item.size);

    img.removeAttribute('src');
    img.alt = item.name;
    img.onload = function () {
      meta.textContent = img.naturalWidth + ' x ' + img.naturalHeight + ' - ' + HP.bytes(item.size);
    };
    img.onerror = function () {
      meta.textContent = 'This file could not be displayed as an image.';
    };
    img.src = url;

    HP.openModal('image-modal');
  }

  async function openEditor(path) {
    editTarget = path;
    document.getElementById('editor-title').textContent = path;
    document.getElementById('editor-msg').textContent = '';
    document.getElementById('editor-dirty').textContent = '';
    HP.openModal('editor-modal');

    var area = document.getElementById('editor-area');
    var info = modeFor(path.split('/').pop());
    document.getElementById('editor-lang').textContent = info.label;

    try {
      var data = await fetch('/api/sites/' + SITE_ID + '/files/read?path=' + encodeURIComponent(path),
        { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      if (data.error) throw new Error(data.error);

      savedContent = data.content;
      document.getElementById('editor-size').textContent = HP.bytes(data.size);

      if (cmAvailable) {
        if (!editor) {
          editor = CodeMirror.fromTextArea(area, {
            lineNumbers: true,
            theme: HP.currentTheme() === 'light' ? 'default' : 'material-darker',
            indentUnit: 2,
            tabSize: 2,
            lineWrapping: false,
            autoCloseBrackets: true,
            matchBrackets: true,
            extraKeys: {
              'Ctrl-S': saveFile,
              'Cmd-S': saveFile,
              Tab: function (cm) {
                if (cm.somethingSelected()) cm.indentSelection('add');
                else cm.replaceSelection('  ', 'end');
              }
            }
          });
          editor.on('cursorActivity', function () {
            var c = editor.getCursor();
            document.getElementById('editor-pos').textContent =
              'Ln ' + (c.line + 1) + ', Col ' + (c.ch + 1);
          });
          editor.on('change', function () {
            document.getElementById('editor-dirty').textContent =
              editor.getValue() === savedContent ? '' : 'unsaved changes';
          });
        }
        editor.setOption('mode', info.mode);
        editor.setOption('theme', HP.currentTheme() === 'light' ? 'default' : 'material-darker');
        editor.setValue(data.content);
        editor.clearHistory();
        setTimeout(function () { editor.refresh(); editor.focus(); }, 40);
      } else {
        // CodeMirror missing: a plain textarea still edits files fine.
        area.value = data.content;
        area.addEventListener('input', function () {
          document.getElementById('editor-dirty').textContent =
            area.value === savedContent ? '' : 'unsaved changes';
        });
      }
    } catch (err) {
      HP.toast(err.message, 'error');
      HP.closeModal('editor-modal');
    }
  }

  function editorValue() {
    return editor ? editor.getValue() : document.getElementById('editor-area').value;
  }

  async function saveFile() {
    var btn = document.getElementById('editor-save');
    btn.disabled = true;
    try {
      var content = editorValue();
      await api('/write', { body: { path: editTarget, content: content } });
      savedContent = content;
      document.getElementById('editor-dirty').textContent = '';
      document.getElementById('editor-msg').textContent = 'Saved at ' + new Date().toLocaleTimeString();
      HP.toast('Saved ' + editTarget, 'ok');
      load(current);
    } catch (err) { HP.toast(err.message, 'error'); }
    btn.disabled = false;
    return false;
  }

  document.getElementById('editor-save').addEventListener('click', saveFile);

  async function closeEditor() {
    if (editorValue() !== savedContent) {
      var choice = await HP.dialog({
        title: 'You have unsaved changes',
        message: 'Save them before closing ' + editTarget + '?',
        tone: 'warn',
        confirmText: 'Save and close',
        extraText: 'Discard changes',
        cancelText: 'Keep editing'
      });
      if (choice === false || choice === null) return;
      if (choice === true) { await saveFile(); }
    }
    HP.closeModal('editor-modal');
  }
  document.getElementById('editor-close').addEventListener('click', closeEditor);
  document.getElementById('editor-cancel').addEventListener('click', closeEditor);

  document.getElementById('editor-wrap').addEventListener('click', function () {
    wrapOn = !wrapOn;
    this.textContent = 'Wrap: ' + (wrapOn ? 'on' : 'off');
    if (editor) editor.setOption('lineWrapping', wrapOn);
    else document.getElementById('editor-area').wrap = wrapOn ? 'soft' : 'off';
  });

  // Ctrl/Cmd+S works even when focus is outside the editor.
  document.addEventListener('keydown', function (e) {
    var open = document.getElementById('editor-modal').classList.contains('open');
    if (open && (e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveFile(); }
  });

  // A plain textarea needs its own tab handling.
  document.getElementById('editor-area').addEventListener('keydown', function (e) {
    if (editor) return;
    if (e.key === 'Tab') {
      e.preventDefault();
      var s = this.selectionStart, en = this.selectionEnd;
      this.value = this.value.slice(0, s) + '  ' + this.value.slice(en);
      this.selectionStart = this.selectionEnd = s + 2;
    }
  });

  // Leaving the page with unsaved work should ask first.
  window.addEventListener('beforeunload', function (e) {
    var open = document.getElementById('editor-modal').classList.contains('open');
    if (open && editorValue() !== savedContent) { e.preventDefault(); e.returnValue = ''; }
  });

  load(current);
</script>
<%- include('partials/foot') %>
