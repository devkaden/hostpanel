<%- include('partials/head') %>
<%- include('partials/nav') %>
<div class="wrap">

  <% if (changed) { %><div class="alert alert-ok">Password updated.</div><% } %>

  <% if (!docker.ok) { %>
    <div class="alert alert-error">
      <strong>Docker is not responding, so sites cannot be created or started.</strong><br>
      <span class="small"><%= docker.error %></span><br>
      Check it is running with <code class="inline">systemctl status docker</code>. If this panel is in an
      LXC container, Docker also needs nesting enabled on that container.
    </div>
  <% } %>

  <% if (!npmplusOn && user.role === 'admin') { %>
    <div class="alert alert-info">
      <strong>No reverse proxy is connected.</strong> Your sites work, but you reach them by port number
      rather than by domain. <a href="/settings">Connect NPMplus in Settings</a> to have domains and
      HTTPS certificates set up for you, or <a href="/setup">run the setup guide</a>.
    </div>
  <% } %>

  <div class="page-head">
    <div>
      <h1>Sites</h1>
      <p class="sub"><%= counts.total %> site<%= counts.total === 1 ? '' : 's' %> &middot; <%= counts.running %> running<% if (counts.stopped) { %> &middot; <%= counts.stopped %> stopped<% } %><% if (counts.missing) { %> &middot; <%= counts.missing %> missing container<% } %></p>
    </div>
    <div class="page-actions">
      <a class="btn btn-primary" href="/sites/new"><%- icon('plus') %><span>New Site</span></a>
    </div>
  </div>

  <div class="grid grid-4" style="margin-bottom:1.4rem">
    <div class="stat"><div class="label">Running</div><div class="value"><%= counts.running %><small> / <%= counts.total %></small></div></div>
    <div class="stat"><div class="label">Host load</div><div class="value"><%= host.load[0] %><small> / <%= host.cpus %> cpu</small></div></div>
    <div class="stat"><div class="label">Memory free</div><div class="value" style="font-size:1.15rem"><%= host.memFree %><small> / <%= host.memTotal %></small></div></div>
    <div class="stat"><div class="label">Uptime</div><div class="value"><%= host.uptime %><small> h</small></div></div>
  </div>

  <% if (!sites.length) { %>
    <div class="card empty">
      <div class="empty-icon"><%- icon('globe', 'ico-lg') %></div>
      <h3>No Sites Yet</h3>
      <p>A site is one website or app. HostPanel gives each one its own isolated
        space, so they cannot interfere with each other.</p>
      <ol class="steps">
        <li><strong>Pick a type</strong> - a plain website, PHP, WordPress, or a Node.js app.</li>
        <li><strong>Give it a name and a domain</strong> - the domain can wait if you are just testing.</li>
        <li><strong>That's it</strong> - the container is built and, if your reverse proxy is connected, the domain and HTTPS are set up too.</li>
      </ol>
      <a class="btn btn-primary mt" href="/sites/new">Create Your First Site</a>
    </div>
  <% } else { %>
    <%
      /* Search is worth showing once there are enough sites to lose one in.
         Below that it is a box that never has anything to do. */
      const showSearch = sites.length >= 5;
    %>
    <% if (showSearch) { %>
      <div class="site-search">
        <%- icon('search') %>
        <input type="search" id="site-search" placeholder="Search sites by name, domain, type or owner"
               autocomplete="off" spellcheck="false" aria-label="Search sites">
        <kbd>/</kbd>
      </div>
    <% } %>

    <div class="site-grid" id="site-grid">
      <% sites.forEach(function (s) { %>
        <%
          const typeLabel = siteTypes[s.type] ? siteTypes[s.type].label : s.type;
          const primary = s.domains.length ? s.domains[0] : null;
          /* One flat haystack per card, so the filter never has to walk the DOM
             hunting for the pieces it wants to match against. */
          const haystack = [s.name, typeLabel, s.owner_name, s.port].concat(s.domains).join(' ').toLowerCase();
        %>
        <article class="site-card" data-site-id="<%= s.id %>" data-search="<%= haystack %>">
          <div class="site-card-head">
            <span class="type-badge" title="<%= typeLabel %>"><%= siteTypes[s.type] ? siteTypes[s.type].icon : '?' %></span>
            <a class="site-card-name" href="/sites/<%= s.id %>"><%= s.name %></a>
            <span class="pill pill-<%= s.live.state %>" data-state><span class="dot"></span><%= s.live.state %></span>
          </div>

          <div class="site-card-domain">
            <% if (primary) { %>
              <a href="http<%= s.ssl ? 's' : '' %>://<%= primary %>" target="_blank" rel="noopener">
                <%= primary %><%- icon('external', 'ico-sm') %>
              </a>
              <% if (s.ssl) { %><span class="pill pill-ssl">SSL</span><% } %>
              <% if (s.domains.length > 1) { %>
                <span class="muted">+<%= s.domains.length - 1 %> more</span>
              <% } %>
            <% } else { %>
              <span class="muted">No domain yet</span>
            <% } %>
          </div>

          <div class="site-card-facts">
            <span><%= typeLabel %></span>
            <span class="adv">Port <%= s.port %></span>
            <% if (user.role === 'admin') { %><span class="adv"><%= s.owner_name %></span><% } %>
          </div>

          <div class="site-card-links">
            <a href="/sites/<%= s.id %>"><%- icon('sites', 'ico-sm') %>Overview</a>
            <a href="/sites/<%= s.id %>/files"><%- icon('folder', 'ico-sm') %>Files</a>
            <a href="/sites/<%= s.id %>/logs"><%- icon('logs', 'ico-sm') %>Logs</a>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="card empty" id="site-search-empty" hidden>
      <div class="empty-icon"><%- icon('search', 'ico-lg') %></div>
      <h3>No Matching Sites</h3>
      <p>Nothing here matches <strong id="site-search-term"></strong>.</p>
    </div>
  <% } %>
</div>

<script>
  /* Search filters what is already on the page.
     Every site is rendered here anyway, so matching in the browser is instant
     and keeps working while the panel is busy - a round trip per keystroke
     would be slower and could fail at exactly the moment someone is looking
     for the site that is misbehaving. */
  (function () {
    var box = document.getElementById('site-search');
    if (!box) return;
    var grid = document.getElementById('site-grid');
    var empty = document.getElementById('site-search-empty');
    var term = document.getElementById('site-search-term');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.site-card'));

    function apply() {
      var q = box.value.trim().toLowerCase();
      var shown = 0;
      cards.forEach(function (card) {
        var hit = !q || card.getAttribute('data-search').indexOf(q) !== -1;
        card.hidden = !hit;
        if (hit) shown += 1;
      });
      empty.hidden = shown > 0;
      if (!shown) term.textContent = box.value.trim();
    }

    box.addEventListener('input', apply);
    box.addEventListener('keydown', function (e) {
      // Escape clears rather than closing the field, so the full list comes
      // back without reaching for the mouse.
      if (e.key === 'Escape' && box.value) { box.value = ''; apply(); e.stopPropagation(); }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      e.preventDefault();
      box.focus();
      box.select();
    });
  })();

  // Keep the status pills fresh without a full page reload.
  setInterval(async function () {
    try {
      const data = await fetch('/api/status', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(r => r.json());
      (data.sites || []).forEach(function (s) {
        const card = document.querySelector('[data-site-id="' + s.id + '"]');
        if (!card) return;
        const pill = card.querySelector('[data-state]');
        if (!pill) return;
        pill.className = 'pill pill-' + s.state;
        pill.innerHTML = '<span class="dot"></span>' + s.state;
      });
    } catch (_) { /* transient */ }
  }, 10000);
</script>
<%- include('partials/foot') %>
