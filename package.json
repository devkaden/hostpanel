{
  "name": "hostpanel",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted web hosting control panel - Docker-per-site, NPMplus reverse proxy integration",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/syntax-check.js",
    "test:npmplus": "node scripts/test-npmplus.js",
    "reset-admin": "node scripts/reset-admin.js",
    "test:security": "node scripts/test-security.js",
    "test": "node scripts/syntax-check.js && node scripts/test-npmplus.js && node scripts/test-security.js && node scripts/test-config.js && node scripts/test-uploads.js",
    "test:config": "node scripts/test-config.js",
    "test:uploads": "node scripts/test-uploads.js",
    "test:upload-live": "node scripts/upload-selftest.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "codemirror": "^5.65.18",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^4.9.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
